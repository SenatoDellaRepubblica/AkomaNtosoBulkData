		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>Dopo il comma 4, inserire il seguente:</an:i>
					 "5. Le amministrazioni interessate provvedono agli adempimenti previsti dalle disposizioni di cui al comma 2, lettere 
					<an:i>a)</an:i>
					, 
					<an:i>b)</an:i>
					 e 
					<an:i>c)</an:i>
					, del presente articolo con le risorse umane, strumentali e finanziarie disponibili a legislazione vigente e, comunque, senza nuovi o maggiori oneri a carico della finanza pubblica.";
				</an:p>
				

				<an:p style="text-align:justify">
					   
					<an:i>conseguentemente</an:i>
					, 
					<an:i>all'articolo 1, comma 3, sostituire le parole</an:i>
					: "Fermo restando quanto previsto agli articoli 3, comma 4, 4, comma 2, 5, comma 3, 6, comma 2, 7, comma 2, 8, comma 3, 9, comma 3, 10, comma 4, e 11, comma 9," 
					<an:i>con le seguenti</an:i>
					: "Fermo restando quanto previsto agli articoli 3, comma 4, 4, comma 2, 5, comma 3, 6, comma 2, 7, comma 2, 8, commi 3 e 4, 9, comma 3, 10, comma 4, 11, comma 9 e 12, comma 5,".
				</an:p>
			</an:amendmentContent>
