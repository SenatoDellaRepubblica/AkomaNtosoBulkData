		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Al comma 1 apportare le seguenti modifiche:</an:i>
				</an:p>
				

				<an:p style="margin-right:0cm">
					          
					<an:i>a)</an:i>
					 
					<an:i>sostituire le parole:</an:i>
					 «dell'articolo 22» 
					<an:i>con le seguenti:</an:i>
					 «degli articoli 5-
					<an:i>bis</an:i>
					 e 22»;
				</an:p>
				

				<an:p style="margin-right:0cm; text-align:justify">
					          
					<an:i>b)</an:i>
					 
					<an:i>alla lettera a) premettere la seguente:</an:i>
					 «
					<an:i>0a)</an:i>
					 prevedere idonei canali e procedure che garantiscano il diritto effettivo, sicuro e riservato di denunciare un reato per i soggetti privati della libertà personale o la cui libertà sia limitata, con particolare riferimento alle persone ristrette in istituti penitenziari, centri di detenzione o celle di sicurezza, nonché nelle strutture di trattenimento per cittadini di paesi terzi;».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
