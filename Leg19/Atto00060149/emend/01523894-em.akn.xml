		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Al comma 1, lettera</an:i>
					 l) 
					<an:i>sopprimere le parole da:</an:i>
					« di onerosità» 
					<an:i>fino a:</an:i>
					 «lettera 
					<an:i>b)</an:i>
					».
				</an:p>
				<an:p>
					<an:i>Conseguentemente, al medesimo comma, lettera</an:i>
					 l)
					<an:i>, sostituire le parole:</an:i>
					 «e di garanzia della sicurezza informatica» 
					<an:i>con le seguenti:</an:i>
					 , di garanzia della sicurezza informatica e di gratuità dell'accesso»
					<an:i>;</an:i>
				</an:p>
				<an:p>
					<an:i>alla lettera</an:i>
					 n) 
					<an:i>sopprimere le parole da:</an:i>
					 «
					<an:i>,</an:i>
					 sulla base del principio di onerosità » 
					<an:i>fino alla fine della lettera.</an:i>
				</an:p>
			</an:amendmentContent>
