		<an:debateBody title="Resoconto n.532 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="14:25:00"/>
					La seduta inizia alle ore 14,25
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="SUI LAVORI DELLA COMMISSIONE">
				
            
				<an:heading id="h-d1e20">SUI LAVORI DELLA COMMISSIONE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:speech by="#p36393" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p36393"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e29" href="#p36393">PRESIDENTE</an:ref>
							  dà conto delle determinazioni assunte nell'Ufficio di Presidenza integrato dai rappresentanti dei Gruppi, dedicato all'organizzazione dei lavori, testé svolto.
						</an:p>
						
                  
						<an:p>
							            In particolare, avverte che si è convenuto di costituire un Comitato ristretto, ai sensi dell'articolo 43, comma 2, del Regolamento, per l'esame dell'A.S. 
							<an:a target="_blank" href="/loc/link.asp?leg=19&amp;tipodoc=ddliter&amp;id=60143">1901</an:a>
							 (
							<an:i>Modifica dell'articolo 12 della Costituzione in materia di riconoscimento dell'inno nazionale</an:i>
							) e di fissare il termine per l'indicazione dei relativi membri, da parte dei Gruppi, alle ore 12 di domani, giovedì 17 settembre.
						</an:p>
						
                  
						<an:p>            La Commissione prende atto.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p29425" as="#senatore">
						
                  
						<an:from refersTo="#p29425"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e43" href="#p29425">GIORGIS</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							) preannuncia che il proprio Gruppo proporrà il senatore Parrini come membro del Comitato.
						</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e50" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e50">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e53" name="1903 e conn.  (Polizia locale)">
					
               
					<an:heading id="h-d1e53"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1903</an:docNumber>
						
                  
						<an:docTitle>Delega al Governo per il riordino delle funzioni e dell'ordinamento della polizia locale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>approvato dalla Camera dei deputati</an:docStatus>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>610</an:docNumber>
						
                  
						<an:docTitle>Legge quadro sull'ordinamento della polizia locale</an:docTitle>
						
                  
						<an:docProponent>BALBONI e altri.</an:docProponent>
						
                  
						<an:docStatus/>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>704</an:docNumber>
						
                  
						<an:docTitle>Disposizioni per il coordinamento in materia di politiche integrate per la sicurezza e di polizia locale</an:docTitle>
						
                  
						<an:docProponent>ROMEO e altri.</an:docProponent>
						
                  
						<an:docStatus/>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>883</an:docNumber>
						
                  
						<an:docTitle>Nuovo ordinamento della polizia locale</an:docTitle>
						
                  
						<an:docProponent>GASPARRI e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame congiunto e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue l'esame congiunto, sospeso nella seduta antimeridiana odierna.</an:narrative>
					
               
					<an:speech by="#p36393" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p36393"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e101" href="#p36393">PRESIDENTE</an:ref>
							  avverte che si riprenderà con la votazione degli emendamenti relativi all'articolo 4.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36395" as="#senatore">
						
                  
						<an:from refersTo="#p36395"/>
						
                  
						<an:p>
							Il relatore 
							<an:ref id="d1e107" href="#p36395">DELLA PORTA</an:ref>
							 (
							<an:i>FdI</an:i>
							) formula un avviso contrario su tutti gli emendamenti riferiti all'articolo 4.
						</an:p>
						
                  
						<an:p>Il sottosegretario Giuseppina CASTIELLO esprime parere conforme a quello del relatore.</an:p>
						
                  
						<an:p>            La Commissione respinge l'emendamento 4.1.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32640" as="#senatore">
						
                  
						<an:from refersTo="#p32640"/>
						
                  
						<an:p>
							La senatrice 
							<an:ref id="d1e117" href="#p32640">GAUDIANO</an:ref>
							 (
							<an:i>M5S</an:i>
							) auspica l'accoglimento dell'emendamento 4.2, volto a garantire la periodicità, continuità e obbligatorietà della formazione prevista dal provvedimento, pur rilevando che, in assenza di adeguata copertura finanziaria, la riforma nel suo complesso non potrà trovare adeguata attuazione.
						</an:p>
						
                  
						<an:p>La Commissione respinge l'emendamento 4.2.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p29604" as="#senatore">
						
                  
						<an:from refersTo="#p29604"/>
						
                  
						<an:p>
							La senatrice 
							<an:ref id="d1e126" href="#p29604">VALENTE</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							), dichiarando il voto favorevole sull'emendamento 4.3, evidenzia come la possibilità di accesso a determinate banche dati dovrebbe essere esplicitata direttamente nella legge di delega.
						</an:p>
						
                  
						<an:p>La Commissione respinge l'emendamento 4.3. Successivamente, l'emendamento 4.0.1 è respinto.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32640" as="#senatore">
						
                  
						<an:from refersTo="#p32640"/>
						
                  
						<an:p>
							La senatrice 
							<an:ref id="d1e135" href="#p32640">GAUDIANO</an:ref>
							 (
							<an:i>M5S</an:i>
							), dichiarando il voto favorevole sull'emendamento 4.0.2, ne illustra la finalità volta a istituire il Consiglio nazionale della polizia locale, composto da comandanti dei corpi di polizia locale e da responsabili dei servizi di polizia locale, avente il compito di promuovere studi e ricerche, nonché di redigere programmi per l'organizzazione delle relative attività.
						</an:p>
						
                  
						<an:p>La Commissione respinge l'emendamento 4.0.2.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p33065" as="#senatore">
						
                  
						<an:from refersTo="#p33065"/>
						
                  
						<an:p>
							Il senatore 
							<an:ref id="d1e144" href="#p33065">CATALDI</an:ref>
							 (
							<an:i>M5S</an:i>
							) auspica l'accoglimento dell'emendamento 4.0.3, segnalando il ritardo di quarant'anni nell'addivenire a una riforma della polizia locale, periodo che sarà ulteriormente prolungato, dal momento che la disciplina dovrà essere attuata attraverso decreti legislativi che il Governo è chiamato ad adottare entro dodici mesi. La proposta emendativa è, quindi, volta, tra l'altro, a inserire con una norma immediatamente efficace i riconoscimenti per le vittime del dovere. Tale proposta ha, inoltre, il merito di indicare le risorse finanziarie necessarie per la relativa attuazione.
						</an:p>
						
                  
						<an:p>La Commissione respinge l'emendamento 4.0.3.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36395" as="#senatore">
						
                  
						<an:from refersTo="#p36395"/>
						
                  
						<an:p>
							Il relatore 
							<an:ref id="d1e153" href="#p36395">DELLA PORTA</an:ref>
							 (
							<an:i>FdI</an:i>
							) formula un avviso contrario su tutti gli emendamenti riferiti all'articolo 5.
						</an:p>
						
                  
						<an:p>Il sottosegretario Giuseppina CASTIELLO esprime parere conforme a quello del relatore.</an:p>
						
                  
						<an:p>La Commissione respinge, con distinte votazioni, gli emendamenti 5.1, 5.2, 5.3, 5.4, 5.5, 5.6, 5.7, 5.8, 5.9, 5.10, 5.11, 5.12, 5.13, 5.14, 5.15, 5.16, 5.0.1 e 5.0.2. Successivamente, gli identici emendamenti 5.0.3 e 5.0.4 sono respinti, con contestuale votazione. In seguito, la Commissione respinge, con distinte votazioni, gli emendamenti 5.0.5 e 5.0.6, nonché, con contestuale votazione, gli identici emendamenti 5.0.7, 5.0.8 e 5.0.9. La Commissione respinge, altresì, con distinte votazioni, gli emendamenti 5.0.10, 5.0.11, 5.0.12, 5.0.13 e 5.0.14.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36395" as="#senatore">
						
                  
						<an:from refersTo="#p36395"/>
						
                  
						<an:p>
							Il relatore 
							<an:ref id="d1e163" href="#p36395">DELLA PORTA</an:ref>
							 (
							<an:i>FdI</an:i>
							) formula un avviso contrario su tutti gli emendamenti riferiti all'articolo 6.
						</an:p>
						
                  
						<an:p>Il sottosegretario Giuseppina CASTIELLO esprime parere conforme a quello del relatore.</an:p>
						
                  
						<an:p>La Commissione respinge, con un'unica votazione, gli identici emendamenti 6.1 e 6.2.</an:p>
						
                  
						<an:p>Successivamente, sono posti distintamente in votazione e respinti gli emendamenti 6.3 e 6.4.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36393" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p36393"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e174" href="#p36393">PRESIDENTE</an:ref>
							  dà atto che si sono concluse le votazioni degli emendamenti e che si procederà, pertanto, nella prossima seduta, con la votazione degli ordini del giorno e con il conferimento del mandato al relatore.
						</an:p>
						
                  
						<an:p>Il seguito dell'esame congiunto è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e178" name="SCONVOCAZIONE DELLA SEDUTA DI DOMANI">
				
            
				<an:heading id="h-d1e178">SCONVOCAZIONE DELLA SEDUTA DI DOMANI</an:heading>
				
            
				<an:debateSection id="d-d1e181" name="">
					
               
					<an:heading id="h-d1e181"/>
					
               
					<an:speech by="#p36393" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p36393"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e187" href="#p36393">PRESIDENTE</an:ref>
							  comunica che la seduta, già convocata domani, giovedì 17 settembre, alle ore 9, non avrà luogo.
						</an:p>
						
                  
						<an:p>            La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
						</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 14,40.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
