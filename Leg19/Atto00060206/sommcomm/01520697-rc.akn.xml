			<an:debateSection id="sede-d1e20" name="IN SEDE REDIGENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REDIGENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Disposizioni in materia di conto corrente">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>763</an:docNumber>
						
                  
						<an:docTitle>Modifica alla legge 27 dicembre 2017, n. 205, in materia di corresponsione della retribuzione su conto corrente intestato al lavoratore</an:docTitle>
						
                  
						<an:docProponent>Elena MURELLI e altri.</an:docProponent>
						
                  
						<an:docStatus/>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1595</an:docNumber>
						
                  
						<an:docTitle>Introduzione dell'articolo 1857-bis del codice civile e modifica all'articolo 33 del codice di cui al decreto legislativo 6 settembre 2005, n. 206, in materia di obbligo di contrarre e recesso della banca nei rapporti di conto corrente</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>approvato dalla Camera dei deputati in un testo risultante dall'unificazione dei disegni di legge d'iniziativa dei deputati Romano e altri; Bagnai e altri</an:docStatus>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1937</an:docNumber>
						
                  
						<an:docTitle>Modifica alla legge 27 dicembre 2017, n. 205, in materia di corresponsione della retribuzione su conto corrente intestato al lavoratore o alla lavoratrice</an:docTitle>
						
                  
						<an:docProponent>Cecilia D'ELIA e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione congiunta e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue la discussione congiunta sospesa nella seduta del 14 luglio.</an:narrative>
					
               
					<an:speech by="#p22963" as="#d1e64a1081">
						
                  
						<an:from refersTo="#p22963"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e64" href="#p22963">PRESIDENTE</an:ref>
							 invita il relatore Borghesi ad approfondire le tematiche connesse al disegno di legge n. 1966, a prima firma del senatore Croatti, in materia di inclusione finanziaria, anche in vista di un possibile abbinamento con le proposte già avviate, al fine di consentire alla Commissione di disporre di un quadro complessivo ed esaustivo della materia prima di definire l'
							<an:i>iter</an:i>
							 dei provvedimenti, attraverso la scelta di un testo base ovvero di un testo unificato.
						</an:p>
						
               
					</an:speech>
					
               
					<an:narrative title="Fisionomia">            Il seguito della discussione congiunta è rinviato.</an:narrative>
					
            
				</an:debateSection>
				
            
				<an:debateSection id="d-d1e70" name="Disposizioni in materia economica, fiscale, nonch&amp;eacute; in materia di tutela dei consumatori">
					
               
					<an:heading id="h-d1e70"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1942</an:docNumber>
						
                  
						<an:docTitle>Disposizioni in materia economica, fiscale, nonché in materia di tutela dei consumatori</an:docTitle>
						
                  
						<an:docProponent>GARAVAGLIA e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue la discussione sospesa nella seduta del 3 agosto.</an:narrative>
					
               
					<an:speech by="#p22963" as="#d1e64a1081">
						
                  
						<an:from refersTo="#p22963"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e90" href="#p22963">PRESIDENTE</an:ref>
							  comunica che sono state presentate le riformulazioni 6.0.6 (testo 2) e 6.0.6 (testo 3), pubblicate in allegato.
						</an:p>
						
                  
						<an:p>            Fa inoltre presente che non è ancora pervenuto il parere della 5ª Commissione sul testo del disegno di legge.</an:p>
						
                  
						<an:p>            Il seguito della discussione è quindi rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,45.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
