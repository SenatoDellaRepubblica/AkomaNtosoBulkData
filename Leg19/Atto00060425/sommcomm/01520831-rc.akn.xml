		<an:debateBody title="Resoconto n.326 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="13:45:00"/>
					La seduta inizia alle ore 13,45
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Conversione in legge del decreto-legge 28 agosto 2026, n. 154, recante misure urgenti per assicurare la continuit&amp;agrave; operativa di impianti di interesse strategico nazionale">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2023</an:docNumber>
						
                  
						<an:docTitle>Conversione in legge del decreto-legge 28 agosto 2026, n. 154, recante misure urgenti per assicurare la continuità operativa di impianti di interesse strategico nazionale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame, sospeso nella seduta del 10 settembre.</an:narrative>
					
               
					<an:speech by="#p32898" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p32898"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e41" href="#p32898">PRESIDENTE</an:ref>
							  ricorda che è aperta la discussione generale e che il termine per la presentazione di emendamenti e ordini del giorno è fissato a giovedì 17 settembre, alle ore 12. Comunica altresì che la Commissione bilancio ha espresso un parere non ostativo.
						</an:p>
						
                  
						<an:p>
							Avverte infine che la documentazione depositata nel corso del ciclo di audizioni, che avrà inizio alle 8.30 di domani, sarà resa disponibile sulla pagina 
							<an:i>web</an:i>
							 della Commissione.
						</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>Il seguito dell'esame viene quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:debateSection id="d-d1e50" name="Misure di consolidamento e sviluppo del settore agricolo">
					
               
					<an:heading id="h-d1e50"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2015</an:docNumber>
						
                  
						<an:docTitle>Misure di consolidamento e sviluppo del settore agricolo</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							approvato dalla Camera dei deputati
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame, sospeso nella seduta del 10 settembre.</an:narrative>
					
               
					<an:speech by="#p32898" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p32898"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e68" href="#p32898">PRESIDENTE</an:ref>
							  ricorda che è aperta la discussione generale. Informa poi che è pervenuto il parere favorevole della 10ª Commissione.
						</an:p>
						
                  
						<an:p>Nessuno chiedendo di intervenire, il seguito dell'esame è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e72" name="IN SEDE CONSULTIVA">
				
            
				<an:heading id="h-d1e72">IN SEDE CONSULTIVA</an:heading>
				
            
				<an:debateSection id="d-d1e75" name="Conversione in legge del decreto-legge 7 agosto 2026, n. 143, recante disposizioni urgenti in materia di obbligo di compostabilit&amp;agrave; di determinate tipologie di imballaggi">
					
               
					<an:heading id="h-d1e75"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2020</an:docNumber>
						
                  
						<an:docTitle>Conversione in legge del decreto-legge 7 agosto 2026, n. 143, recante disposizioni urgenti in materia di obbligo di compostabilità di determinate tipologie di imballaggi</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Parere alla 8ª Commissione. Seguito e conclusione dell'esame. Parere favorevole
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame, sospeso nella seduta del 10 settembre.</an:narrative>
					
               
					<an:speech by="#p32898" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p32898"/>
						
                  
						<an:p>
							Non essendoci interventi in discussione generale, il 
							<an:ref id="d1e93" href="#p32898">PRESIDENTE</an:ref>
							  dichiara conclusa tale fase procedurale.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36427" as="#senatore">
						
                  
						<an:from refersTo="#p36427"/>
						
                  
						<an:p>
							La relatrice 
							<an:ref id="d1e99" href="#p36427">SPELGATTI</an:ref>
							 (
							<an:i>LSP-PSd'Az</an:i>
							) propone di formulare un parere favorevole.
						</an:p>
						
                  
						<an:p>Verificato il prescritto numero di senatori, la proposta di parere favorevole viene posta ai voti e approvata.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e105" name="SULLA DISCUSSIONE CONGIUNTA DEI DISEGNI DI LEGGE N. 928 E N. 1768 (PRODOTTI AGROALIMENTARI DI QUALITA')">
				
            
				<an:heading id="h-d1e105">SULLA DISCUSSIONE CONGIUNTA DEI DISEGNI DI LEGGE N. 928 E N. 1768 (PRODOTTI AGROALIMENTARI DI QUALITA')</an:heading>
				
            
				<an:debateSection id="d-d1e108" name="">
					
               
					<an:heading id="h-d1e108"/>
					
               
					<an:speech by="#p32898" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p32898"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e114" href="#p32898">PRESIDENTE</an:ref>
							  comunica che, nel corso della prossima settimana, ricomincerà il ciclo di audizioni sui provvedimenti in titolo.
						</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
						</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 13,50.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
