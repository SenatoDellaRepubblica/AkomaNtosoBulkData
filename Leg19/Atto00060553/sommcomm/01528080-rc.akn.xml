		<an:debateBody title="Resoconto n.316 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="00:00:00"/>
					La seduta inizia alle ore 14.
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="2074 - d-l 193/2026 Misure urgenti per l'autotrasporto, l'agricoltura e la pesca">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2074</an:docNumber>
						
                  
						<an:docTitle>Conversione in legge del decreto-legge 23 ottobre 2026, n. 193, recante disposizioni urgenti e misure di sostegno ai settori dell'autotrasporto, dell'agricoltura e della pesca</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame, sospeso nella seduta di ieri.</an:narrative>
					
               
					<an:speech by="#p36420" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p36420"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e41" href="#p36420">PRESIDENTE</an:ref>
							  comunica che sono stati presentati 250 emendamenti e 6 ordini del giorno, pubblicati in allegato.
						</an:p>
						
                  
						<an:p>Il seguito dell'esame è rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e45" name="INTEGRAZIONE DELL'ORDINE DEL GIORNO E CONVOCAZIONE DI UNA NUOVA SEDUTA">
				
            
				<an:heading id="h-d1e45">INTEGRAZIONE DELL'ORDINE DEL GIORNO E CONVOCAZIONE DI UNA NUOVA SEDUTA</an:heading>
				
            
				<an:debateSection id="d-d1e48" name="">
					
               
					<an:heading id="h-d1e48"/>
					
               
					<an:speech by="#p4192" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p4192"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e54" href="#p4192">PRESIDENTE</an:ref>
							  informa che è stato assegnato, in sede referente, il disegno di legge di conversione del decreto-legge 28 settembre 2026, n. 167, recante misure urgenti per la circolazione dei veicoli ad alimentazione diesel appartenenti alla categoria ambientale «EURO 5», approvato dalla Camera dei deputati (A.S. 
							<an:a href="https://www.senato.it/leggi-e-documenti/disegni-di-legge/scheda-ddl?tab=datiGenerali&amp;did=60596">2091</an:a>
							).
						</an:p>
						
                  
						<an:p>Come già preannunciato nella seduta di ieri, comunica che l'ordine del giorno è conseguentemente integrato e che la Commissione è nuovamente convocata al termine della seduta in corso per avviare l'esame del provvedimento.</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 14,05.     </an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
