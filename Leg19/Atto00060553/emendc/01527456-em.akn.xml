			<an:p>
				<an:docNumber>Emendamento n. Coord.1</an:docNumber>
			</an:p>
			<an:p>
				<an:docProponent refersTo="#ID0E5">
					<an:span style="font-variant:small-caps;">Il</an:span>
					 
					<an:span style="font-variant:small-caps;">Relatore</an:span>
				</an:docProponent>
			</an:p>
		</an:preface>
		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>All'articolo 1:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 4:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>                        alla lettera</an:i>
					 a)
					<an:i>, la parola:</an:i>
					 «soppressi» 
					<an:i>è sostituita dalla seguente:</an:i>
					 «abrogati»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                        
					<an:i>alla lettera</an:i>
					 b)
					<an:i>, la parola:</an:i>
					 «soppresso» 
					<an:i>è sostituita dalla seguente:</an:i>
					 «abrogato»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                        
					<an:i>alla lettera</an:i>
					 c)
					<an:i>:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>                                    al numero 1), le parole:</an:i>
					 «all'alinea, sostituire: "1, 2, 4," con i numeri: "1, 2"» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «, alinea, le parole: "articoli 1, 2, 4" sono sostituite dalle seguenti: "articoli 1, 2"» 
					<an:i>e le parole:</an:i>
					 «con le seguenti» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «sono sostituite dalle seguenti»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                                    
					<an:i>al numero 2), le parole:</an:i>
					 «sostituire le parole» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «, le parole» 
					<an:i>e le parole:</an:i>
					 «con le seguenti» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «sono sostituite dalle seguenti»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					            
					<an:i>al comma 5, le parole:</an:i>
					 «e dal comma 3» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «, e dal comma 3,».
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>All'articolo 2:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 1, capoverso 5-</an:i>
					bis
					<an:i>, primo periodo, dopo le parole:</an:i>
					 «sul proprio sito» 
					<an:i>è inserita la seguente:</an:i>
					 «
					<an:i>internet</an:i>
					».
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>All'articolo 3:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 1, le parole:</an:i>
					 «Albo nazionale degli autotrasportatori» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «albo nazionale degli autotrasportatori di cose per conto di terzi».
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>All'articolo 5:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 1:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>                        all'alinea, dopo le parole:</an:i>
					 «all'articolo 12 del» 
					<an:i>sono inserite le seguenti:</an:i>
					 «codice della strada, di cui al»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                        
					<an:i>alla lettera</an:i>
					 b) 
					<an:i>sono aggiunte, in fine, le seguenti parole:</an:i>
					 «, di cui alla legge 6 dicembre 1960, n. 1621»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                        
					<an:i>alla lettera</an:i>
					 c) 
					<an:i>sono aggiunte, in fine, le seguenti parole:</an:i>
					 «, pubblicato nella 
					<an:i>Gazzetta Ufficiale</an:i>
					 n. 65 del 19 marzo 2001»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					            
					<an:i>al comma 2, dopo le parole:</an:i>
					 «con le medesime» 
					<an:i>è inserito il seguente segno di interpunzione:</an:i>
					 «,»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					            
					<an:i>al comma 3, dopo le parole:</an:i>
					 «all'articolo 12 del» 
					<an:i>sono inserite le seguenti:</an:i>
					 «codice della strada, di cui al»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					            
					<an:i>al comma 4, le parole:</an:i>
					 «in vigore del presente articolo» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «in vigore del presente decreto».
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>All'articolo 6:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 1, le parole:</an:i>
					 «all'AGEA» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «all'Agenzia per le erogazioni in agricoltura (AGEA)»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					            
					<an:i>al comma 3, dopo le parole:</an:i>
					 «Medio Oriente» 
					<an:i>sono inserite le seguenti:</an:i>
					 «, di cui alla comunicazione della Commissione C/2026/2593,».
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>All'articolo 9:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>            al comma 1:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>                        alla lettera</an:i>
					 f)
					<an:i>, le parole:</an:i>
					 «con modificazioni dall'articolo 1, comma 1, della» 
					<an:i>sono sostituite dalla seguente:</an:i>
					 «, con modificazioni, dalla»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					                        
					<an:i>alla lettera</an:i>
					 h)
					<an:i>, dopo le parole:</an:i>
					 «del Fondo» 
					<an:i>è inserita la seguente:</an:i>
					 «per».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
