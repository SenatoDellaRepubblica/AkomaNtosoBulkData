		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:i>Apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>a) al comma 1:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:i>1)  sostituire le parole</an:i>
					: «tra il 1° giugno e il 15 ottobre 2026» 
					<an:i>con le seguenti:</an:i>
					  «tra il 1° giugno e il 31 dicembre 2026»;
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>2) sostituire le parole:</an:i>
					 «nel limite di 60 milioni di euro per l'anno 2026» 
					<an:i>con le seguenti:</an:i>
					 «nel limite di 200 milioni di euro per l'anno 2026»;
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>b) dopo il comma 4 aggiungere il seguente:</an:i>
					 «4
					<an:i>-bis</an:i>
					. Agli oneri del presente articolo, valutati in 200 milioni di euro per l'anno 2026, si provvede quanto a 60 milioni di euro ai sensi dell'articolo 9 del presente decreto legge e quanto ai restanti 140 milioni di euro mediante corrispondente riduzione del Fondo di cui all'articolo 1, comma 200, della legge 23 dicembre 2014, n. 190.».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
