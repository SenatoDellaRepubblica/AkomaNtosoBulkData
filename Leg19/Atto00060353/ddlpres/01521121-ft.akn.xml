		<an:coverPage>
			<an:p>SENATO DELLA REPUBBLICA</an:p>
			<an:p>
				<an:docType>DISEGNO DI LEGGE</an:docType>
			</an:p>
			<an:p>
				<an:docNumber>N. 1987</an:docNumber>
			</an:p>
			<an:p>
				<an:docTitle>
					Istituzione del percorso formativo nazionale per i 
					<an:i>caregiver</an:i>
					 di cani
					<an:eol/>
					e disposizioni per la prevenzione delle morsicature canine e la promozione del possesso responsabile degli animali d'affezione
				</an:docTitle>
			</an:p>
			


			<an:p>
				d'iniziativa del senatore 
				<an:docProponent refersTo="#w9aab1b3b5b1b1b1b1" as="#w9aab1b3b5b1b1b1b1Aa">DE POLI</an:docProponent>
			</an:p>
			

			<an:p>COMUNICATO ALLA PRESIDENZA IL 29 LUGLIO 2026</an:p>
			


		</an:coverPage>
		<an:body title="DISEGNO DI LEGGE">
			


			<an:article id="w9aab1b7b3">
				<an:num>Art. 1.</an:num>
				

				<an:heading id="w9aab1b7b3b2">
					<an:i>(Finalità)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7b3b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7b3b4a">
						<an:intro id="w9aab1b7b3b4b1">
							<an:p>La presente legge disciplina un sistema nazionale di prevenzione delle morsicature canine e di promozione del possesso responsabile degli animali d'affezione, al fine di:</an:p>
						</an:intro>
						<an:point id="w9aab1b7b3b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b3b4b3b1">
								<an:p>ridurre l'incidenza e la gravità degli episodi di aggressione;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b3b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b3b4b5b1">
								<an:p>
									migliorare le competenze dei 
									<an:i>caregiver</an:i>
									;
								</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b3b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b3b4b7b1">
								<an:p>tutelare il benessere animale;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b3b4b9">
							<an:num>
								<an:i>d)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b3b4b9b1">
								<an:p>rafforzare la sicurezza pubblica.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7b5">
				<an:num>Art. 2.</an:num>
				

				<an:heading id="w9aab1b7b5b2">
					<an:i>(Definizioni)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7b5b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7b5b4a">
						<an:intro id="w9aab1b7b5b4b1">
							<an:p>Ai fini della presente legge si intende per:</an:p>
						</an:intro>
						<an:point id="w9aab1b7b5b4b3">
							<an:num>
								<an:i>a) </an:i>
							</an:num>
							<an:content id="w9aab1b7b5b4b3b1">
								<an:p>
									<an:i>caregiver</an:i>
									: il proprietario o detentore responsabile del cane;
								</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b5b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b5b4b5b1">
								<an:p>situazioni a rischio: le condizioni individuate sulla base dei criteri multifattoriali definiti ai sensi dell'articolo 15.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7b7">
				<an:num>Art. 3.</an:num>
				

				<an:heading id="w9aab1b7b7b2">
					<an:i>
						(Istituzione del percorso formativo
						<an:eol/>
						nazionale)
					</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7b7b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7b7b4b1">
						<an:p>
							È istituito il percorso formativo nazionale per i 
							<an:i>caregiver</an:i>
							 di cani, finalizzato alla prevenzione delle morsicature e alla gestione consapevole dell'animale.
						</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7b7b6">
					<an:num>2. </an:num>
					<an:list id="w9aab1b7b7b6a">
						<an:intro id="w9aab1b7b7b6b1">
							<an:p>Il percorso formativo nazionale si articola in:</an:p>
						</an:intro>
						<an:point id="w9aab1b7b7b6b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b7b6b3b1">
								<an:p>un percorso di formazione di base;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b7b6b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b7b6b5b1">
								<an:p>
									percorsi formativi rafforzati per i soggetti individuati nell'ambito delle situazioni a rischio di cui all'articolo 2, comma 1, lettera 
									<an:i>b)</an:i>
									.
								</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7b9">
				<an:num>Art. 4.</an:num>
				

				<an:heading id="w9aab1b7b9b2">
					<an:i>(Obbligo formativo)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7b9b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7b9b4a">
						<an:intro id="w9aab1b7b9b4b1">
							<an:p>La partecipazione al percorso formativo di cui all'articolo 3 è obbligatorio per:</an:p>
						</an:intro>
						<an:point id="w9aab1b7b9b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b9b4b3b1">
								<an:p>
									i nuovi 
									<an:i>caregiver</an:i>
									;
								</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7b9b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7b9b4b5b1">
								<an:p>
									i 
									<an:i>caregiver</an:i>
									 individuati nell'ambito delle situazioni a rischio di cui all'articolo 2, comma 1, lettera 
									<an:i>b)</an:i>
									.
								</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7b9b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7b9b6b1">
						<an:p>
							I soggetti che, alla data di entrata in vigore della presente legge, rivestono il ruolo di 
							<an:i>caregiver</an:i>
							, adempiono all'obbligo formativo di cui al comma 1 entro quarantotto mesi dalla medesima data.
						</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7b9b8">
					<an:num>3. </an:num>
					<an:content id="w9aab1b7b9b8b1">
						<an:p>L'obbligo formativo può essere assolto mediante il superamento di una verifica preliminare delle competenze.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c11">
				<an:num>Art. 5.</an:num>
				

				<an:heading id="w9aab1b7c11b2">
					<an:i>(Contenuti del percorso formativo)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c11b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c11b4a">
						<an:intro id="w9aab1b7c11b4b1">
							<an:p>Il percorso formativo di cui all'articolo 3 comprende, in particolare, i seguenti ambiti:</an:p>
						</an:intro>
						<an:point id="w9aab1b7c11b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4b3b1">
								<an:p>etologia e comportamento del cane;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c11b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4b5b1">
								<an:p>comunicazione tra essere umano e animale;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c11b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4b7b1">
								<an:p>gestione quotidiana e bisogni dell'animale;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c11b4b9">
							<an:num>
								<an:i>d)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4b9b1">
								<an:p>prevenzione dell'aggressività;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c11b4c11">
							<an:num>
								<an:i>e)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4c11b1">
								<an:p>sicurezza nelle interazioni;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c11b4c13">
							<an:num>
								<an:i>f)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c11b4c13b1">
								<an:p>normativa vigente e responsabilità connesse alla proprietà e alla detenzione del cane.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c11b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c11b6b1">
						<an:p>È vietato il ricorso a metodi coercitivi e a strumenti avversivi, individuati secondo criteri stabiliti ai sensi dell'articolo 15.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c13">
				<an:num>Art. 6.</an:num>
				

				<an:heading id="w9aab1b7c13b2">
					<an:i>(Sistema di valutazione)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c13b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c13b4a">
						<an:intro id="w9aab1b7c13b4b1">
							<an:p>È istituito un sistema di valutazione basato:</an:p>
						</an:intro>
						<an:point id="w9aab1b7c13b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c13b4b3b1">
								<an:p>sulla raccolta dei dati e sulla loro integrazione integrazione con i dati dell'anagrafe canina;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c13b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c13b4b5b1">
								<an:p>sull'analisi multifattoriale del rischio;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c13b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c13b4b7b1">
								<an:p>sull'utilizzo di protocolli scientificamente validati.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c13b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c13b6b1">
						<an:p>Il sistema di valutazione del rischio non è basato sull'appartenenza del cane a una determinata razza.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c15">
				<an:num>Art. 7.</an:num>
				

				<an:heading id="w9aab1b7c15b2">
					<an:i>(Interventi nelle situazioni a rischio)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c15b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c15b4a">
						<an:intro id="w9aab1b7c15b4b1">
							<an:p>
								Nelle situazioni a rischio individuate ai sensi dell'articolo 2, comma 1, lettera 
								<an:i>b)</an:i>
								, possono essere disposti:
							</an:p>
						</an:intro>
						<an:point id="w9aab1b7c15b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c15b4b3b1">
								<an:p>la partecipazione obbligatoria a percorsi formativi;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c15b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c15b4b5b1">
								<an:p>il ricorso al supporto specialistico veterinario;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c15b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c15b4b7b1">
								<an:p>prescrizioni relative alla gestione del cane.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c15b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c15b6b1">
						<an:p>
							L'allontanamento del cane dal 
							<an:i>caregiver</an:i>
							 può essere disposto esclusivamente come misura eccezionale .
						</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c17">
				<an:num>Art. 8.</an:num>
				

				<an:heading id="w9aab1b7c17b2">
					<an:i>
						(Misure in favore dei soggetti in condizioni
						<an:eol/>
						di fragilità)
					</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c17b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c17b4b1">
						<an:p>
							I 
							<an:i>caregiver</an:i>
							 di età superiore a settanta anni possono individuare un soggetto garante.
						</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c17b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c17b6b1">
						<an:p>
							Il garante assume la responsabilità giuridica e gestionale dell'animale nei casi in cui il 
							<an:i>caregiver</an:i>
							 sia impossibilitato a provvedervi.
						</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c19">
				<an:num>Art. 9.</an:num>
				

				<an:heading id="w9aab1b7c19b2">
					<an:i>(Figure professionali)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c19b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c19b4a">
						<an:intro id="w9aab1b7c19b4b1">
							<an:p>All'attuazione delle disposizioni della presente legge concorrono, secondo le rispettive competenze:</an:p>
						</an:intro>
						<an:point id="w9aab1b7c19b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c19b4b3b1">
								<an:p>i medici veterinari delle aziende sanitarie locali;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c19b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c19b4b5b1">
								<an:p>i medici veterinari esperti in comportamento animale;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c19b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c19b4b7b1">
								<an:p>gli educatori e gli istruttori cinofili qualificati;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c19b4b9">
							<an:num>
								<an:i>d)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c19b4b9b1">
								<an:p>gli psicologi.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c21">
				<an:num>Art. 10.</an:num>
				

				<an:heading id="w9aab1b7c21b2">
					<an:i>(Modalità di attuazione)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c21b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c21b4b1">
						<an:p>All'attuazione delle disposizioni della presente legge provvedono, secondo le rispettive competenze, le regioni, le aziende sanitarie locali e gli enti locali.</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c21b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c21b6b1">
						<an:p>I percorsi formativi di cui alla presente legge possono essere erogati in presenza, in modalità telematica o integrata.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c23">
				<an:num>Art. 11.</an:num>
				

				<an:heading id="w9aab1b7c23b2">
					<an:i>(Sperimentazione)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c23b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c23b4b1">
						<an:p>
							Al fine di valutare l'efficacia delle misure previste dalla presente legge e di definirne i relativi 
							<an:i>standard</an:i>
							 nazionali, è avviata una fase di sperimentazione territoriale della durata di ventiquattro mesi.
						</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c25">
				<an:num>Art. 12.</an:num>
				

				<an:heading id="w9aab1b7c25b2">
					<an:i>(Sanzioni)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c25b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c25b4b1">
						<an:p>Il mancato adempimento degli obblighi formativi di cui all'articolo 4 comporta l'applicazione di una sanzione amministrativa pecuniaria.</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c25b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c25b6b1">
						<an:p>L'applicazione della sanzione di cui al comma 1 non esonera dall'adempimento dell'obbligo formativo, al quale l'interessato è tenuto a provvedere entro i termini stabiliti dall'autorità competente.</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c25b8">
					<an:num>3. </an:num>
					<an:content id="w9aab1b7c25b8b1">
						<an:p>In caso di reiterata inadempienza degli obblighi di cui al comma 1 possono essere adottate misure progressive di limitazione della detenzione dell'animale.</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c25c10">
					<an:num>4. </an:num>
					<an:content id="w9aab1b7c25c10b1">
						<an:p>I proventi derivanti dall'applicazione delle sanzioni sono destinati al finanziamento di interventi per la tutela del benessere animale e per la prevenzione egli episodi di aggressione.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c27">
				<an:num>Art. 13.</an:num>
				

				<an:heading id="w9aab1b7c27b2">
					<an:i>(Monitoraggio e valutazione)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c27b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c27b4a">
						<an:intro id="w9aab1b7c27b4b1">
							<an:p>È istituito un sistema di monitoraggio dell'attuazione della presente legge basato sui seguenti indicatori di efficacia:</an:p>
						</an:intro>
						<an:point id="w9aab1b7c27b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c27b4b3b1">
								<an:p>numero degli episodi di morsicatura;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c27b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c27b4b5b1">
								<an:p>numero degli accessi ai servizi sanitari conseguenti a morsicature canine;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c27b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c27b4b7b1">
								<an:p>tasso di partecipazione ai percorsi formativi.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c27b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c27b6b1">
						<an:p>I risultati del monitoraggio sono sottoposti a valutazione almeno ogni tre anni.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c29">
				<an:num>Art. 14.</an:num>
				

				<an:heading id="w9aab1b7c29b2">
					<an:i>(Clausola di invarianza finanziaria)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c29b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c29b4b1">
						<an:p>Dall'attuazione delle disposizioni della presente legge non devono derivare nuovi o maggiori oneri a carico della finanza pubblica.</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w9aab1b7c29b6">
					<an:num>2. </an:num>
					<an:content id="w9aab1b7c29b6b1">
						<an:p>Le amministrazioni interessate provvedono agli adempimenti con le risorse umane, finanziarie e strumentali disponibili a legislazione vigente.</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c31">
				<an:num>Art. 15.</an:num>
				

				<an:heading id="w9aab1b7c31b2">
					<an:i>(Decreti attuativi)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c31b4">
					<an:num>1. </an:num>
					<an:list id="w9aab1b7c31b4a">
						<an:intro id="w9aab1b7c31b4b1">
							<an:p>Entro sei mesi dalla data di entrata in vigore della presente legge, con uno o più decreti del Ministro della salute, di concerto con il Ministro dell'interno, sono stabiliti:</an:p>
						</an:intro>
						<an:point id="w9aab1b7c31b4b3">
							<an:num>
								<an:i>a)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c31b4b3b1">
								<an:p>i contenuti e la durata dei percorsi formativi di cui all'articolo 3;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c31b4b5">
							<an:num>
								<an:i>b)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c31b4b5b1">
								<an:p>i criteri per la valutazione del rischio e le modalità operative del sistema di cui all'articolo 6;</an:p>
							</an:content>
						</an:point>
						<an:point id="w9aab1b7c31b4b7">
							<an:num>
								<an:i>c)</an:i>
								 
							</an:num>
							<an:content id="w9aab1b7c31b4b7b1">
								<an:p>i criteri per l'individuazione dei metodi coercitivi e degli strumenti avversivi di cui all'articolo 5, comma 2.</an:p>
							</an:content>
						</an:point>
					</an:list>
				</an:paragraph>
				

			</an:article>
			

			<an:article id="w9aab1b7c33">
				<an:num>Art. 16.</an:num>
				

				<an:heading id="w9aab1b7c33b2">
					<an:i>(Entrata in vigore)</an:i>
				</an:heading>
				

				<an:paragraph id="w9aab1b7c33b4">
					<an:num>1. </an:num>
					<an:content id="w9aab1b7c33b4b1">
						<an:p>
							La presente legge entra in vigore il sessantesimo giorno successivo a quello della sua pubblicazione nella 
							<an:i>Gazzetta Ufficiale.</an:i>
						</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

		</an:body>
