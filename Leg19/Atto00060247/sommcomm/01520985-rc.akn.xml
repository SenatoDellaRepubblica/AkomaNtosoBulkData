				<an:collectionBody>
					
               
					<an:interstitial id="d1e86">
						
                  
						<an:p/>
						
                  
						<an:p style="text-align:center;">
							
                     
							<an:b>PARERE APPROVATO DALLA COMMISSIONE</an:b>
							
                  
						</an:p>
						
                  
						<an:p style="text-align:center;">
							
                     
							<an:b>SULL'ATTO DEL GOVERNO N. 427</an:b>
							
                  
						</an:p>
						
                  
						<an:p>La 6ª Commissione Finanze e tesoro,</an:p>
						
                  
						<an:p>            esaminato lo schema di decreto legislativo recante recepimento della direttiva (UE) 2024/2810 del Parlamento europeo e del Consiglio, del 23 ottobre 2024, sulle strutture con azioni a voto plurimo nelle società che chiedono l'ammissione alla negoziazione delle loro azioni in un sistema multilaterale di negoziazione e adeguamento dell'ordinamento nazionale alle disposizioni del regolamento (UE) 2024/2809 del Parlamento europeo e del Consiglio, del 23 ottobre 2024, che modifica i regolamenti (UE) 2017/1129, (UE) n. 596/2014 e (UE) n. 600/2014 per rendere i mercati pubblici dei capitali nell'Unione più attraenti per le società e facilitare l'accesso delle piccole e medie imprese ai capitali,</an:p>
						
                  
						<an:p>            premesso che:</an:p>
						
                  
						<an:p>            il provvedimento attua in maniera corretta i principi recati dalla delega;</an:p>
						
                  
						<an:p>            apprezzata la scelta di non inserire ulteriori clausole di salvaguardia pur previste dalla direttiva;</an:p>
						
                  
						<an:p>            esprime parere favorevole con la seguente osservazione:</an:p>
						
                  
						<an:p>            Valuti il Governo l'opportunità di inserire appositi presidi utili a bilanciare una struttura azionaria con voto plurimo e gli interessi degli azionisti non detentori di azioni a voto plurimo, che si muovono in una logica di investimento e non di controllo societario.</an:p>
						
               
					</an:interstitial>
					
            
