		<an:debateBody title="Resoconto n.356 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="15:30:00"/>
					La seduta inizia alle ore 15,30
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE CONSULTIVA SU ATTI DEL GOVERNO">
				
            
				<an:heading id="h-d1e20">IN SEDE CONSULTIVA SU ATTI DEL GOVERNO</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Schema di decreto legislativo recante interventi di coordinamento e correttivi di disposizioni emanate in attuazione della delega fiscale">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>Doc</an:docType>
						
                  
						<an:docNumber>n. 451</an:docNumber>
						
                  
						<an:docTitle>Schema di decreto legislativo recante interventi di coordinamento e correttivi di disposizioni emanate in attuazione della delega fiscale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Parere al Ministro per i rapporti con il Parlamento, ai sensi degli articoli 1, comma 6, e 21 della legge 9 agosto 2023, n. 111. Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue l'esame sospeso nella seduta dell'11 novembre.</an:narrative>
					
               
					<an:speech by="#p36449" as="#senatore">
						
                  
						<an:from refersTo="#p36449"/>
						
                  
						<an:p>
							            La relatrice 
							<an:ref id="d1e40" href="#p36449">TUBETTI</an:ref>
							 (
							<an:i>FdI</an:i>
							) preannuncia la predisposizione di un parere da sottoporre alla Commissione nella prossima seduta.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p37739" as="#d1e53a1081">
						
                  
						<an:from refersTo="#p37739"/>
						
                  
						<an:p>
							            Dopo un intervento della senatrice 
							<an:ref id="d1e48" href="#p37739">TAJANI</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							), il 
							<an:ref id="d1e53" href="#p22963">PRESIDENTE</an:ref>
							  rinvia la discussione una volta acquisita la proposta di parere.
						</an:p>
						
                  
						<an:p>            Il seguito dell'esame è rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e57" name="IN SEDE REDIGENTE">
				
            
				<an:heading id="h-d1e57">IN SEDE REDIGENTE</an:heading>
				
            
				<an:debateSection id="d-d1e60" name="Disposizioni in materia economica, fiscale, nonch&amp;eacute; in materia di tutela dei consumatori">
					
               
					<an:heading id="h-d1e60"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1942</an:docNumber>
						
                  
						<an:docTitle>Disposizioni in materia economica, fiscale, nonché in materia di tutela dei consumatori</an:docTitle>
						
                  
						<an:docProponent>GARAVAGLIA e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue la discussione sospesa nella seduta pomeridiana del 7 ottobre.</an:narrative>
					
               
					<an:speech by="#p22963" as="#d1e53a1081">
						
                  
						<an:from refersTo="#p22963"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e80" href="#p22963">PRESIDENTE</an:ref>
							  comunica che è stato presentato l'ordine del giorno G/1942/2/6 (già em. 6.0.11), pubblicato in allegato.
						</an:p>
						
                  
						<an:p>            Avverte che la fase consultiva in Commissione bilancio potrà costituire l'occasione per sciogliere alcune questioni poste dagli emendamenti approvati: in particolare, l'emendamento relativo al potenziamento del quadrante Europa di Verona e le disposizioni relative alle sollecitazioni commerciali telefoniche. In attesa che si concluda la fase presso la 5ª Commissione, rinvia la discussione ad altra seduta.</an:p>
						
                  
						<an:p>            Il seguito della discussione è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:debateSection id="d-d1e85" name="Modifica alla legge 27 dicembre 2017, n. 205, in materia di corresponsione della retribuzione su conto corrente intestato al lavoratore">
					
               
					<an:heading id="h-d1e85"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>763</an:docNumber>
						
                  
						<an:docTitle>Modifica alla legge 27 dicembre 2017, n. 205, in materia di corresponsione della retribuzione su conto corrente intestato al lavoratore</an:docTitle>
						
                  
						<an:docProponent>Elena MURELLI e altri.</an:docProponent>
						
                  
						<an:docStatus/>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1937</an:docNumber>
						
                  
						<an:docTitle>Modifica alla legge 27 dicembre 2017, n. 205, in materia di corresponsione della retribuzione su conto corrente intestato al lavoratore o alla lavoratrice</an:docTitle>
						
                  
						<an:docProponent>Cecilia D'ELIA e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione congiunta e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue la discussione congiunta sospesa nella seduta del 3 novembre.</an:narrative>
					
               
					<an:speech by="#p37739" as="#d1e53a1081">
						
                  
						<an:from refersTo="#p37739"/>
						
                  
						<an:p>
							            Dopo un intervento della senatrice 
							<an:ref id="d1e115" href="#p37739">TAJANI</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							), il 
							<an:ref id="d1e120" href="#p22963">PRESIDENTE</an:ref>
							  ricorda che la Commissione bilancio non ha ancora espresso il parere sulla proposta di legge assunta come testo base.
						</an:p>
						
                  
						<an:p>            Il seguito della discussione congiunta è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:debateSection id="d-d1e124" name="Introduzione dell'articolo 1857-bis del codice civile e modifica all'articolo 33 del codice di cui al decreto legislativo 6 settembre 2005, n. 206, in materia di obbligo di contrarre e recesso della banca nei rapporti di conto corrente">
					
               
					<an:heading id="h-d1e124"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1595</an:docNumber>
						
                  
						<an:docTitle>Introduzione dell'articolo 1857-bis del codice civile e modifica all'articolo 33 del codice di cui al decreto legislativo 6 settembre 2005, n. 206, in materia di obbligo di contrarre e recesso della banca nei rapporti di conto corrente</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus/>
						
               
					</an:block>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1966</an:docNumber>
						
                  
						<an:docTitle>Disposizioni per il riconoscimento del diritto alla cittadinanza economica e per il rafforzamento dell'accesso ai servizi bancari essenziali</an:docTitle>
						
                  
						<an:docProponent>TURCO e CROATTI.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione congiunta e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue la discussione congiunta sospesa nella seduta del 3 novembre.</an:narrative>
					
               
					<an:speech by="#p22963" as="#d1e53a1081">
						
                  
						<an:from refersTo="#p22963"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e155" href="#p22963">PRESIDENTE</an:ref>
							  avverte che si passerà all'esame degli emendamenti presentati al disegno di legge n. 1595 assunto come testo base.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32608" as="#senatore">
						
                  
						<an:from refersTo="#p32608"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e161" href="#p32608">CROATTI</an:ref>
							 (
							<an:i>M5S</an:i>
							) illustra l'emendamento 1.1, interamente sostitutivo del disegno di legge, sottolineando che esso ha il pregio di accogliere le numerose valutazioni critiche emerse nel corso del ciclo di audizioni. Auspica, quindi, che la maggioranza e il Governo possano valutare positivamente tale proposta.
						</an:p>
						
                  
						<an:p>            Sono quindi dati per illustrati i restanti emendamenti.</an:p>
						
                  
						<an:p>            Il seguito della discussione congiunta è rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 15,40.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
