					<an:heading id="w9aab1b5b3b4b2">CONTO DEL BILANCIO</an:heading>
					

					<an:article id="w9aab1b5b3b4b4">
						<an:num>Art. 1.</an:num>
						

						<an:heading id="w9aab1b5b3b4b4b2">
							<an:i>(Entrate)</an:i>
						</an:heading>
						

						<an:paragraph id="w9aab1b5b3b4b4b4">
							<an:num>1. </an:num>
							<an:content id="w9aab1b5b3b4b4b4b1">
								<an:p>Le entrate tributarie, extratributarie, per alienazione e ammortamento di beni patrimoniali e riscossione di crediti nonché per accensione di prestiti, accertate nell'esercizio finanziario 2025 per la competenza propria dell'esercizio, risultano stabilite in euro 1.188.132.031.515,93.</an:p>
							</an:content>
						</an:paragraph>
						

						<an:paragraph id="w9aab1b5b3b4b4b6">
							<an:num>2. </an:num>
							<an:content id="w9aab1b5b3b4b4b6b1">
