						<an:from refersTo="#p4192"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e264" href="#p4192">PRESIDENTE</an:ref>
							  comunica che la Commissione è ulteriormente convocata oggi, mercoledì 23 settembre, alle ore 12,45.
						</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 11,05.</an:i>
							
                  
						</an:p>
						
               
