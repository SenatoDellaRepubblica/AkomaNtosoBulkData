				<an:docTitle>Modifica all'articolo 114 della Costituzione, concernente il riconoscimento dell'area metropolitana di Milano quale ente territoriale autonomo</an:docTitle>
			</an:p>
			


			<an:p>
				d'iniziativa del senatore 
				<an:docProponent refersTo="#w9aab1b3b5b1b1b1b1" as="#w9aab1b3b5b1b1b1b1Aa">SCALFAROTTO</an:docProponent>
