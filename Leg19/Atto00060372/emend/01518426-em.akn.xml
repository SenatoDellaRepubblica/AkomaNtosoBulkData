		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Dopo l'articolo</an:i>
					, 
					<an:i>inserire il seguente:</an:i>
				</an:p>
				<an:p>
					<an:b>
						"Art. 15-
						<an:i>bis</an:i>
						.
					</an:b>
				</an:p>
				<an:p>          1. All'articolo 1, comma 683, della legge 30 dicembre 2025, n. 199, sono apportate le seguenti modificazioni:</an:p>
				<an:p>
					<an:i>a)</an:i>
					 al primo periodo, le parole: «anche nell'anno 2026» sono sostituite dalle seguenti: «anche negli anni 2026 e 2027»;
				</an:p>
				<an:p>
					<an:i>b)</an:i>
					 al secondo periodo, le parole: «incassato nell'anno 2026» sono sostituite dalle seguenti: «incassato negli anni 2026 e 2027».
				</an:p>
			</an:amendmentContent>
