			</an:debateSection>
			
         
			<an:debateSection id="d1e102" name="FineSeduta">
				
            
				<an:narrative title="FineSeduta">
					
               
					<an:recordedTime time="09:05:00"/>
					
            
				</an:narrative>
				
         
			</an:debateSection>
			
      
