			<an:debateSection id="sede-d1e30" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e30">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e33" name="(2065) d-l 185/2026 - ILVA">
					
               
					<an:heading id="h-d1e33"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2065</an:docNumber>
						
                  
						<an:docTitle>Conversione in legge del decreto-legge 16 ottobre 2026, n. 185, recante misure urgenti a sostegno dei lavoratori dell'ex ILVA e dell'indotto e per il rilancio industriale del territorio</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">           Prosegue l'esame, sospeso nella seduta di ieri.</an:narrative>
					
               
					<an:speech by="#p32732" as="#senatore">
						
                  
						<an:from refersTo="#p32732"/>
						
                  
						<an:p>
							           Il presidente 
							<an:ref id="d1e51" href="#p32732">ZAFFINI</an:ref>
							 dà conto della presentazione dei subemendamenti riferiti all'emendamento 1.100 dei relatori (pubblicati in allegato). Dichiara quindi l'inammissibilità del subemendamento 1.100/1.
						</an:p>
						
                  
						<an:p>I restanti subemendamenti sono dati per illustrati.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32732" as="#senatore">
						
                  
						<an:from refersTo="#p32732"/>
						
                  
						<an:p>
							Il presidente 
							<an:ref id="d1e58" href="#p32732">ZAFFINI</an:ref>
							 avverte che nella seduta di domani potranno avere inizio le votazioni degli emendamenti.
						</an:p>
						
                  
						<an:p>Le Commissioni riunite prendono atto.</an:p>
						
                  
						<an:p>           Il seguito dell'esame è quindi rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 14,35.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
