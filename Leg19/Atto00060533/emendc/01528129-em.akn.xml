		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>         Apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="margin-left:35.25pt; text-align:justify">
					          
					<an:i>a) al comma 3, aggiungere, in fine, il seguente periodo:</an:i>
					 «L'informativa di cui al presente comma è trasmessa, altresì, alla regione territorialmente competente.»;
				</an:p>
				

				<an:p style="margin-left:35.25pt; text-align:justify">
					          
					<an:i>b) dopo il comma 7, inserire il seguente:</an:i>
				</an:p>
				

				<an:p style="margin-left:35.25pt; text-align:justify">
					          «7-
					<an:i>bis</an:i>
					. I lavoratori possono rivolgersi ai centri per l'impiego territorialmente competenti per il supporto alle attività di cui al comma 7, secondo periodo.».
				</an:p>
				

				<an:p style="margin-left:35.25pt; margin-right:0cm; text-align:justify">
					<an:i>          Conseguentemente all'articolo 2, dopo il comma 1, inserire il seguente:</an:i>
				</an:p>
				

				<an:p style="margin-left:35.25pt; margin-right:0cm; text-align:justify">
					            «1-
					<an:i>bis</an:i>
					. I lavoratori possono rivolgersi ai centri per l'impiego territorialmente competenti per il supporto alle attività di cui al comma 1, terzo periodo.».
				</an:p>
			</an:amendmentContent>
			<an:amendmentContent>
