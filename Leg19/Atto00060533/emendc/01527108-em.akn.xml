		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Al comma 1, capoverso «</an:i>
					Art. 3
					<an:i>», apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p>
					          
					<an:i>a) al comma 1:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          1) 
					<an:i>dopo le parole:</an:i>
					 «raccoglie e coordina» 
					<an:i>inserire le seguenti:</an:i>
					 «, anche mediante il supporto tecnico-operativo dell'Agenzia nazionale per l'attrazione degli investimenti e lo sviluppo d'impresa S.p.A. - Invitalia,»;
				</an:p>
				

				<an:p style="text-align:justify">
					          2) 
					<an:i>sostituire le parole</an:i>
					: «ai 10 milioni» 
					<an:i>con le seguenti:</an:i>
					 «ad 1 milione»;
				</an:p>
				

				<an:p style="text-align:justify">
					          3) 
					<an:i>dopo le parole:</an:i>
					 «elabora un Piano degli investimenti» 
					<an:i>aggiungere le seguenti:</an:i>
					 «, nonché i necessari aggiornamenti,»;
				</an:p>
				

				<an:p style="text-align:justify">
					          b
					<an:i>) al comma 2, aggiungere, in fine, il seguente periodo:</an:i>
					 «Il Commissario straordinario può, altresì, promuovere la definizione di accordi per lo sviluppo territoriale delle aree, anche con riferimento al Piano degli investimenti di cui al comma 1 e agli altri investimenti rilevanti per il territorio, coinvolgendo le amministrazioni statali competenti, la Regione Puglia e gli altri enti locali interessati, sentite le parti sociali e il gestore dello stabilimento».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
