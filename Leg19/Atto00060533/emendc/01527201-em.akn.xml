		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="">
					<an:i>Al comma 1, sostituire le parole da:</an:i>
					 «di 15 milioni», 
					<an:i>fino alla fine del periodo, con le seguenti:</an:i>
					 «di 50 milioni di euro per l'anno 2026 e di 100 milioni di euro per l'anno 2027».
				</an:p>
				

				<an:p style="">
					     
					<an:i>Conseguentemente, al comma 2:</an:i>
				</an:p>
				

				<an:p style="">
					          a) 
					<an:i>sostituire la parola:</an:i>
					 «15»; 
					<an:i>con la seguente:</an:i>
					 «50»;
				</an:p>
				

				<an:p style="line-height:150%;">
					          b) 
					<an:i>sostituire la parola:</an:i>
					 «30"» 
					<an:i>con la seguente:</an:i>
					 «100»;
				</an:p>
				

				<an:p style="">
					          c) 
					<an:i>sostituire la parole</an:i>
					 
					<an:i>da:</an:i>
					 «del Fondo sociale», 
					<an:i>fino alla fine del comma, con le seguenti:</an:i>
					 «del Fondo di cui all'articolo 1, comma 200, della legge 23 dicembre 2014, n. 190.».
				</an:p>
			</an:amendmentContent>
