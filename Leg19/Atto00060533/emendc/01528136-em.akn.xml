		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>All'articolo 1:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, dopo le parole:</an:i>
					 «in amministrazione straordinaria» 
					<an:i>il segno di interpunzione</an:i>
					 «,» 
					<an:i>è soppresso</an:i>
					;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 3, le parole:</an:i>
					 «comma 2,» 
					<an:i>sono sostituite con le seguenti:</an:i>
					 «comma 2 e».
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 3, dopo la parola:</an:i>
					 «prevedibile» 
					<an:i>sono inserite le seguenti:</an:i>
					 «della medesima sospensione o riduzione».
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 12, le parole:</an:i>
					 «"Fondo sociale per occupazione e formazione"» 
					<an:i>sono sostituite dalle seguenti</an:i>
					: «Fondo sociale per occupazione e formazione,».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 2:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 6, le parole:</an:i>
					 «"Fondo sociale per occupazione e formazione" di cui all'articolo» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «Fondo sociale per occupazione e formazione, di cui al citato articolo».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 3:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, le parole:</an:i>
					 «2029, di» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «2029 e di»;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 8:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>                        all'alinea, le parole:</an:i>
					 «2029, e a» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «2029 e»;
				</an:p>
				

				<an:p style="text-align:justify">
					                                  
					<an:i>alla lettera</an:i>
					 a)
					<an:i>, dopo le parole:</an:i>
					 «per l'anno 2030» 
					<an:i>è inserito il seguente segno di interpunzione:</an:i>
					 «,»;
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>alla lettera</an:i>
					 b)
					<an:i>, dopo le parole:</an:i>
					 «per l'anno 2031» 
					<an:i>è inserito il seguente segno di interpunzione:</an:i>
					 «,» 
					<an:i>e le parole:</an:i>
					 «2029 e a 1,3» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «2029 e 1,3».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 5:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, capoverso Art. 3:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>                        al comma 1, secondo periodo, dopo la parola:</an:i>
					 «commissario» 
					<an:i>è inserita la seguente:</an:i>
					 «straordinario»;
				</an:p>
				

				<an:p style="text-align:justify">
					                                  
					<an:i>al comma 4, dopo le parole:</an:i>
					 «della disciplina» 
					<an:i>sono inserite le seguenti:</an:i>
					 «relativa alla».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 6:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 2, dopo le parole:</an:i>
					 «Le imprese» 
					<an:i>e dopo le parole:</an:i>
					 «degli occupati» 
					<an:i>il segno di interpunzione</an:i>
					 «,» 
					<an:i>è soppresso.</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 7:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 2, le parole:</an:i>
					 «e del Ministro dell'ambiente» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «e con il Ministro dell'ambiente»;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 4, primo periodo, dopo le parole:</an:i>
					 «nel distretto» 
					<an:i>sono inserite le seguenti:</an:i>
					 «di cui al comma 1».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 8:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 2, le parole:</an:i>
					 «dall'articolo 1, comma 1, della» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «dalla».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 9:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, le parole:</an:i>
					 «di euro a decorrere dal 2027» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «di euro annui a decorrere dall'anno 2027»;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 2, le parole:</an:i>
					 «a decorrere dal 2027» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «a decorrere dall'anno 2027».
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>All'articolo 10:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 2:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>                        all'alinea, dopo le parole:</an:i>
					 «dal comma 1» 
					<an:i>è inserito il seguente segno di interpunzione:</an:i>
					 «,» 
					<an:i>e le parole:</an:i>
					 «e a 13 milioni di euro per l'anno 2029» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «e 13 milioni di euro per l'anno 2029,»;
				</an:p>
				

				<an:p style="text-align:justify">
					                                  
					<an:i>alla lettera</an:i>
					 a)
					<an:i>, le parole:</an:i>
					 «e a 13 milioni di euro per l'anno 2029» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «e 13 milioni di euro per l'anno 2029,»;
				</an:p>
				

				<an:p style="text-align:justify">
					                                  
					<an:i>alla lettera</an:i>
					 b)
					<an:i>, dopo le parole:</an:i>
					 «per l'anno 2028» 
					<an:i>è inserito il seguente segno di interpunzione:</an:i>
					 «,».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
