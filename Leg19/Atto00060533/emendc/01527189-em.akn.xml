		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify;">
					<an:i>Al comma 1, apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="margin-left:46.4pt;text-align:justify;">
					          
					<an:i>a)</an:i>
					 
					<an:i>dopo le parole:</an:i>
					 «ai lavoratori dipendenti della società Adi Servizi Marittimi S.r.l.» 
					<an:i>inserire le seguenti:</an:i>
					 «e a tutti i lavoratori impiegati con contratti di appalto, subappalto, somministrazione o contratti di lavoro atipici operanti nell'alveo della medesima filiera produttiva»;
				</an:p>
				

				<an:p style="margin-left:46.4pt;text-align:justify;">
					          
					<an:i>b)</an:i>
					 
					<an:i>dopo il comma 1, aggiungere il seguente:</an:i>
				</an:p>
				

				<an:p style="text-align:justify;">
					          «1-
					<an:i>bis</an:i>
					. Per tali lavoratori è garantita la piena continuità occupazionale e di reddito attraverso l'attivazione di una clausola sociale obbligatoria, che vincola i futuri acquirenti o gestori dei complessi aziendali all'assorbimento totale della forza lavoro senza soluzioni di continuità.»;
				</an:p>
				

				<an:p style="margin-left:46.4pt;text-align:justify;">
					          
					<an:i>c)</an:i>
					 
					<an:i>al comma 8:</an:i>
				</an:p>
				

				<an:p style="margin-left:54.0pt;text-align:justify;">
					          1) 
					<an:i>sostituire le parole:</an:i>
					 «27,3 milioni» 
					<an:i>con le seguenti:</an:i>
					 «62,3 milioni»;
				</an:p>
				

				<an:p style="margin-left:54.0pt;text-align:justify;">
					          2) 
					<an:i>sostituire le parole:</an:i>
					 «56,1 milioni», 
					<an:i>con le seguenti:</an:i>
					 «91,1 milioni».
				</an:p>
				

				<an:p style="margin-left:46.4pt;text-align:justify;">
					          
					<an:i>d)</an:i>
					 
					<an:i>al comma 11:</an:i>
				</an:p>
				

				<an:p style="margin-left:54.0pt;text-align:justify;">
					          1) 
					<an:i>sostituire le parole:</an:i>
					 «27,3 milioni» 
					<an:i>con le seguenti:</an:i>
					 «62,3 milioni»;
				</an:p>
				

				<an:p style="margin-left:54.0pt;text-align:justify;">
					          2) 
					<an:i>sostituire le parole:</an:i>
					 «56,1 milioni», 
					<an:i>con le seguenti:</an:i>
					 «91,1 milioni»;
				</an:p>
				

				<an:p style="margin-left:54.0pt;text-align:justify;">
					          3) 
					<an:i>sostituire le parole da:</an:i>
					 «corrispondente riduzione», 
					<an:i>fino alla fine del comma, con le seguenti:</an:i>
					 «oppressione dei sussidi ambientalmente dannosi (SAD), di cui all'articolo 68 della legge 28 dicembre 2015, n. 221, individuati con decreto del Ministro dell'ambiente e della sicurezza energetica, sentito il Ministro dell'economia e delle finanze.».
				</an:p>
			</an:amendmentContent>
