		<an:debateBody title="Resoconto n.343 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="08:35:00"/>
					La seduta inizia alle ore 8,35
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Disposizioni in materia di cinema">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2035</an:docNumber>
						
                  
						<an:docTitle>Disposizioni in materia di cinema</an:docTitle>
						
                  
						<an:docProponent>Deputato Elly SCHLEIN e altri.</an:docProponent>
						
                  
						<an:docStatus>
							approvato dalla Camera dei deputati in un testo risultante dall'unificazione dei disegni di legge d'iniziativa dei deputati Elly Schlein e altri, Mollicone e altri, Amato e altri, Valentina Grippo, Giorgia Latini e altri
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue l'esame sospeso nella seduta del 6 ottobre.</an:narrative>
					
               
					<an:speech by="#p29480" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e43" href="#p29480">PRESIDENTE</an:ref>
							  comunica che, alla scadenza del termine fissato alle ore 10 di giovedì 8 ottobre, sono stati presentati 14 emendamenti e 1 ordine del giorno (pubblicati in allegato).
						</an:p>
						
                  
						<an:p>Si passa all'illustrazione dell'ordine del giorno e degli emendamenti.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32856" as="#senatore">
						
                  
						<an:from refersTo="#p32856"/>
						
                  
						<an:p>
							La senatrice 
							<an:ref id="d1e50" href="#p32856">BUCALO</an:ref>
							 (
							<an:i>FdI</an:i>
							) dà per illustrato l'unico ordine del giorno, di cui è firmataria.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p34243" as="#senatore">
						
                  
						<an:from refersTo="#p34243"/>
						
                  
						<an:p>
							Il senatore 
							<an:ref id="d1e58" href="#p34243">PAGANELLA</an:ref>
							 (
							<an:i>LSP-PSd'Az</an:i>
							), dati per illustrati gli emendamenti a propria firma, preannuncia sin d'ora l'intenzione di ritirarli per trasformarli in ordini del giorno.
						</an:p>
						
                  
						<an:p>Nessun altro senatore chiedendo di intervenire, i restanti emendamenti sono dati per illustrati.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p29480" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e67" href="#p29480">PRESIDENTE</an:ref>
							  informa che è giunto il parere favorevole della 9ª Commissione permanente (Industria, commercio, turismo, agricoltura e produzione agroalimentare), mentre non sono ancora pervenuti i pareri delle Commissioni affari costituzionali e bilancio. Non è pertanto possibile procedere alla votazione degli emendamenti.
						</an:p>
						
                  
						<an:p>            Il seguito dell'esame è quindi rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e73" name="ANTICIPAZIONE DELL'UFFICIO DI PRESIDENZA">
				
            
				<an:heading id="h-d1e73">ANTICIPAZIONE DELL'UFFICIO DI PRESIDENZA</an:heading>
				
            
				<an:debateSection id="d-d1e76" name="">
					
               
					<an:heading id="h-d1e76"/>
					
               
					<an:speech by="#p29480" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e82" href="#p29480">PRESIDENTE</an:ref>
							 , tenuto conto dell'andamento dei lavori, propone di anticipare alle ore 8,40 di oggi la riunione dell'Ufficio di Presidenza integrato dai rappresentati dei Gruppi parlamentari, già convocata per le ore 8,45, per lo svolgimento delle audizioni sul disegno di legge n. 
							<an:a target="_blank" href="/loc/link.asp?leg=19&amp;tipodoc=ddliter&amp;id=60495">2053</an:a>
							 (Conversione in legge del decreto-legge 30 settembre 2026, n. 170, recante misure urgenti per garantire il regolare avvio dell'anno scolastico 2026/2027, per l'accompagnamento delle misure del Piano nazionale di ripresa e resilienza (PNRR) di competenza del Ministero dell'istruzione e del merito, per la promozione dell'integrazione degli studenti stranieri nell'ambito scolastico, nonché in materia di formazione superiore e ricerca).
						</an:p>
						
                  
						<an:p>Non essendovi obiezioni, così resta stabilito.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 8,40.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
