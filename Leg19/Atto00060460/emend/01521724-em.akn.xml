		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					Dopo l'
					<an:i>
						<an:b>articolo</an:b>
					</an:i>
					inserire il seguente:
				</an:p>
				<an:p>
					<an:b>"Art. 2.1</an:b>
				</an:p>
				<an:p>
					(
					<an:i>Modifiche agli articoli 1</an:i>
					-bis 
					<an:i>e 1</an:i>
					-ter 
					<an:i>del decreto-legge 24 gennaio 2025, n. 3, convertito, con modificazioni, dalla legge 20 marzo 2025, n. 31)</an:i>
				</an:p>
				<an:p>          1.Al decreto-legge 24 gennaio 2025, n. 3, convertito, con modificazioni, dalla legge 20 marzo 2025, n. 31, sono apportate le seguenti modificazioni:</an:p>
				<an:p>
					          a) all'articolo 1-
					<an:i>bis</an:i>
					, comma 1, cpv. 2
					<an:i>-ter</an:i>
					, sono aggiunte, in fine, le seguenti parole: "e comprende, altresì, i dati del Documento di Valutazione dei Rischi (DVR) e del registro dei lavoratori esposti a sostanze cancerogene.";
				</an:p>
				<an:p>
					          b) all'articolo 1-
					<an:i>ter</an:i>
					, comma 1, primo periodo, sono aggiunte, in fine, le seguenti parole: "e recante, altresì, i dati del Documento di Valutazione dei Rischi (DVR) e del registro dei lavoratori esposti a sostanze cancerogene".
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
