		<an:coverPage>
			<an:p>SENATO DELLA REPUBBLICA</an:p>
			<an:p>
				<an:docType>DISEGNO DI LEGGE</an:docType>
			</an:p>
			<an:p>
				<an:docNumber>N. 2086</an:docNumber>
			</an:p>
			<an:p>
				<an:docTitle>Conversione in legge del decreto-legge 6 novembre 2026, n. 200, recante misure urgenti per assicurare la continuità delle funzioni dell'Autorità nazionale anticorruzione (ANAC)</an:docTitle>
			</an:p>
			


			<an:p>
				presentato dal 
				<an:docProponent refersTo="#w25aab1b3b5b1b1b1b1" as="#w25aab1b3b5b1b1b1b1Aa">Presidente del Consiglio dei ministri (MELONI)</an:docProponent>
				 e dal 
				<an:docProponent refersTo="#w25aab1b3b5b1b1b1b3" as="#w25aab1b3b5b1b1b1b3Aa">Ministro per la pubblica amministrazione (ZANGRILLO)</an:docProponent>
				 di concerto con il 
				<an:docProponent refersTo="#w25aab1b3b5b1b1b1b5" as="#w25aab1b3b5b1b1b1b5Aa">Ministro dell'interno (PIANTEDOSI)</an:docProponent>
				 e con il 
				<an:docProponent refersTo="#w25aab1b3b5b1b1b1b7" as="#w25aab1b3b5b1b1b1b7Aa">Ministro della giustizia (NORDIO)</an:docProponent>
			</an:p>
			

			<an:p>COMUNICATO ALLA PRESIDENZA IL 6 NOVEMBRE 2026</an:p>
			


		</an:coverPage>
		<an:body title="DISEGNO DI LEGGE">
			


			<an:article id="w25aab1b9b3">
				<an:num>Art. 1.</an:num>
				

				<an:paragraph id="w25aab1b9b3b2">
					<an:num>1. </an:num>
					<an:content id="w25aab1b9b3b2b1">
						<an:p>È convertito in legge il decreto-legge 6 novembre 2026, n. 200, recante misure urgenti per assicurare la continuità delle funzioni dell'Autorità nazionale anticorruzione (ANAC).</an:p>
					</an:content>
				</an:paragraph>
				

				<an:paragraph id="w25aab1b9b3b4">
					<an:num>2. </an:num>
					<an:content id="w25aab1b9b3b4b1">
						<an:p>
							La presente legge entra in vigore il giorno successivo a quello della sua pubblicazione nella 
							<an:i>Gazzetta Ufficiale</an:i>
							.
						</an:p>
					</an:content>
				</an:paragraph>
				

			</an:article>
			

		</an:body>
