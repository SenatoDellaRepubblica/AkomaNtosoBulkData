			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Riordino e riorganizzazione del Consiglio universitario nazionale">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1890</an:docNumber>
						
                  
						<an:docTitle>Riordino e riorganizzazione del Consiglio universitario nazionale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame sospeso nella seduta del 22 luglio.</an:narrative>
					
               
					<an:speech by="#p29480" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e41" href="#p29480">PRESIDENTE</an:ref>
							  comunica che sono giunti i pareri, di tenore non ostativo, delle Commissioni affari costituzionali e bilancio, sugli emendamenti precedentemente accolti dalla Commissione.
						</an:p>
						
                  
						<an:p>Avverte altresì che, in ragione dell'imminente inizio dei lavori dell'Assemblea, si procederà alla votazione del mandato al relatore nella seduta pomeridiana di oggi.</an:p>
						
                  
						<an:p>Prende atto la Commissione.</an:p>
						
                  
						<an:p>Il seguito dell'esame è quindi rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
						</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 10,07.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
