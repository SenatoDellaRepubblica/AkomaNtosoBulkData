		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					<an:span style="font-size:medium">
						<an:i>All'articolo 1, comma 1, lettera</an:i>
						 a)
						<an:i>:</an:i>
					</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">
						<an:i>al numero 1), come sostituito dall'emendamento 1.100 (testo 4), al capoverso 1), dopo le parole:</an:i>
						 «esplicita le modalità di sostegno didattico» 
						<an:i>inserire le seguenti:</an:i>
						 «, compresa la proposta del numero di ore di sostegno alla classe»
						<an:i>;</an:i>
					</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">
						<an:i>al numero 4), come sostituito dall'emendamento 1.100 (testo 4), al capoverso g-</an:i>
						bis
						<an:i>), sostituire le parole:</an:i>
						 «sviluppo evolutivo dello studente» 
						<an:i>con le seguenti:</an:i>
						 «sviluppo evolutivo della persona»
						<an:i>.</an:i>
					</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">
						<an:i>All'articolo 7, comma 13-</an:i>
						novies
						<an:i>, introdotto dagli identici emendamenti 7.91 (testo 2) e 7.92 (testo 2), sostituire le parole:</an:i>
						 «e, in ogni caso, a decorrere dall'anno formativo 2027/2028,» 
						<an:i>con le seguenti:</an:i>
						 «e, comunque, per l'anno formativo 2027/2028,»
						<an:i>.</an:i>
					</an:span>
				</an:p>
			</an:amendmentContent>
