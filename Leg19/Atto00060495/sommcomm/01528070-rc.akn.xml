		<an:debateBody title="Resoconto n.360 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="14:55:00"/>
					La seduta inizia alle ore 14,55
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Conversione in legge del decreto-legge 30 settembre 2026, n. 170, recante misure urgenti per garantire il regolare avvio dell'anno scolastico 2026/2027, per l'accompagnamento delle misure del Piano nazionale di ripresa e resilienza (PNRR) di competenza del Ministero dell'istruzione e del merito, per la promozione dell'integrazione degli studenti stranieri nell'ambito scolastico, nonch&amp;eacute; in materia di formazione superiore e ricerca">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2053</an:docNumber>
						
                  
						<an:docTitle>Conversione in legge del decreto-legge 30 settembre 2026, n. 170, recante misure urgenti per garantire il regolare avvio dell'anno scolastico 2026/2027, per l'accompagnamento delle misure del Piano nazionale di ripresa e resilienza (PNRR) di competenza del Ministero dell'istruzione e del merito, per la promozione dell'integrazione degli studenti stranieri nell'ambito scolastico, nonché in materia di formazione superiore e ricerca</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue l'esame, sospeso nella seduta di ieri.</an:narrative>
					
               
					<an:speech by="#p29480" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e41" href="#p29480">PRESIDENTE</an:ref>
							  informa di aver riformulato l'emendamento 1.100 (testo 3) in un nuovo testo, pubblicato in allegato, al fine di tener conto di alcune sollecitazioni avanzate, per le vie brevi, da alcune amministrazioni locali.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p31875" as="#senatore">
						
                  
						<an:from refersTo="#p31875"/>
						
                  
						<an:p>
							            La senatrice 
							<an:ref id="d1e47" href="#p31875">D'ELIA</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							) chiede chiarimenti in merito alla nuova formulazione.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p29480" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e55" href="#p29480">PRESIDENTE</an:ref>
							 , in qualità di relatore, fornisce le delucidazioni richieste, segnalando che la nuova formulazione attribuisce al PEI non già un potere di definizione vincolante delle risorse che gli enti locali devono mettere a disposizione per l'assistenza all'autonomia e alla comunicazione, bensì un mero potere di formulare una proposta al riguardo.
						</an:p>
						
                  
						<an:p>Quindi, tenuto conto che sono ancora in corso approfondimenti da parte del Governo sull'impatto finanziario di tale proposta emendativa, nonché della maggior parte delle ulteriori proposte accantonate, che auspica possano concludersi nella giornata odierna, propone di convocare un'ulteriore seduta pomeridiana per le ore 18, compatibilmente con i lavori dell'Assemblea.</an:p>
						
                  
						<an:p>            Conviene la Commissione.</an:p>
						
                  
						<an:p>            Il seguito dell'esame è, quindi, rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e61" name="CONVOCAZIONE DI UN'ULTERIORE SEDUTA POMERIDIANA DI OGGI">
				
            
				<an:heading id="h-d1e61">CONVOCAZIONE DI UN'ULTERIORE SEDUTA POMERIDIANA DI OGGI</an:heading>
				
            
				<an:debateSection id="d-d1e64" name="">
					
               
					<an:heading id="h-d1e64"/>
					
               
					<an:speech by="#p29480" as="#d1e41a1081">
						
                  
						<an:from refersTo="#p29480"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e70" href="#p29480">PRESIDENTE</an:ref>
							 , come appena deciso, comunica che la Commissione è ulteriormente convocata oggi, alle ore 18.
						</an:p>
						
                  
						<an:p>            Prende atto la Commissione.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 15,05.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
