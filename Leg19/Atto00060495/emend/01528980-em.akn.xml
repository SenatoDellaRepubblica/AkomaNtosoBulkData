		<an:amendmentBody>
			<an:amendmentContent>
				

				<an:p>
					<an:i>Dopo il comma 13</an:i>
					-novies
					<an:i>, aggiungere i seguenti:</an:i>
				</an:p>
				

				<an:p>
					               "13
					<an:i>-decies</an:i>
					. All'articolo 2, commi 1, 2 e 3 della legge 18 luglio 2003, n. 186 le parole «del 70 per cento» sono sostituite dalle seguenti: «dell'80 per cento dal 1° settembre 2027, del 90 per cento dal 1° settembre 2028 e del 95 percento dal 1° settembre 2029»
				</an:p>
				

				<an:p>
					                    13-undecim. All'articolo 1
					<an:i>-bis</an:i>
					, comma 2
					<an:i>-bis</an:i>
					, del decreto-legge 29 ottobre 2019, n. 126, convertito, con modificazioni, dalla legge 20 dicembre 2019, n. 159, le parole: « Per l'anno scolastico 2025/2026 e 2026/2027 » sono sostituite dalle seguenti: « Per ciascuno degli anni scolastici 2025/2026, 2026/2027, 2027/2028 e 2028/2029 »"
				</an:p>
				

			</an:amendmentContent>
			<an:amendmentContent>
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03">
					<an:outcome id="esito">Improcedibile</an:outcome>
				</an:p>
			</an:amendmentContent>
