		<an:debateBody title="Resoconto n.324 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="17:05:00"/>
					La seduta inizia alle ore 17,05
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="SUI LAVORI DELLA COMMISSIONE">
				
            
				<an:heading id="h-d1e20">SUI LAVORI DELLA COMMISSIONE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:speech by="#p22910" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22910"/>
						
                  
						<an:p>
							La 
							<an:ref id="d1e29" href="#p22910">PRESIDENTE</an:ref>
							  avverte che è stato assegnato alla Commissione, in sede referente, l'Atto Senato n. 1978 di conversione in legge, con modificazioni, del decreto-legge 26 giugno 2026, n. 108, recante disposizioni urgenti in materia di sport, per lo svolgimento di grandi eventi e l'efficacia del documento di identità. Propone pertanto di integrare l'ordine del giorno e di convocare immediatamente un'ulteriore seduta per la trattazione dell'atto.
						</an:p>
						
                  
						<an:p>Nessuno intervenendo in senso contrario, così rimane stabilito.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e33" name="CONVOCAZIONE DI UNA ULTERIORE SEDUTA E INTEGRAZIONE DELL'ORDINE DEL GIORNO">
				
            
				<an:heading id="h-d1e33">CONVOCAZIONE DI UNA ULTERIORE SEDUTA E INTEGRAZIONE DELL'ORDINE DEL GIORNO</an:heading>
				
            
				<an:debateSection id="d-d1e36" name="">
					
               
					<an:heading id="h-d1e36"/>
					
               
					<an:speech by="#p22910" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22910"/>
						
                  
						<an:p>
							La 
							<an:ref id="d1e42" href="#p22910">PRESIDENTE</an:ref>
							  comunica che, come appena stabilito, la Commissione è nuovamente convocata al termine della seduta in corso e che l'ordine del giorno della stessa è integrato con l'esame, in sede referente, dell'Atto Senato n. 1978.    
						</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 17,10.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
