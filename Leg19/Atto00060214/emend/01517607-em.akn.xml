		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Al comma 2, lettera b), numero 4), capoverso 2</an:i>
					-quinquies
					<an:i>, al terzo periodo, sostituire le parole</an:i>
					: «procede al fermo per compiere» 
					<an:i>con le parole</an:i>
					: «compie».
				</an:p>
				<an:p>
					<an:i>Conseguentemente:</an:i>
				</an:p>
				<an:p>
					<an:i>- al medesimo capoverso, sopprimere il quarto, il quinto, il sesto, il settimo, l'ottavo e il nono periodo;</an:i>
				</an:p>
				<an:p>
					<an:i>- sopprimere il capoverso</an:i>
					 «
					<an:i>2</an:i>
					-septies»
					<an:i>.</an:i>
				</an:p>
			</an:amendmentContent>
