		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Apportare le seguenti modificazioni:</an:i>
				</an:p>
				<an:p>
					          a) 
					<an:i>al comma 1, sostituire le parole</an:i>
					: «due prove scritte» 
					<an:i>con le seguenti</an:i>
					: «una prova scritta»;
				</an:p>
				<an:p>
					          b) 
					<an:i>al comma 2, apportare le seguenti modifiche</an:i>
					:
				</an:p>
				<an:p>
					               1) 
					<an:i>al primo periodo sostituire le parole</an:i>
					: «Le prove scritte» 
					<an:i>con le seguenti</an:i>
					: «La prova scritta»;
				</an:p>
				<an:p>
					               2) 
					<an:i>al quarto periodo sostituire le parole</an:i>
					: «Le prove» 
					<an:i>con le seguenti</an:i>
					: «La prova»;
				</an:p>
				<an:p>
					<an:i/>
					 3) 
					<an:i>sopprimere la lettera a)</an:i>
					;
				</an:p>
				<an:p>
					          c) 
					<an:i>al comma 5 sostituire le parole</an:i>
					: «di ciascuna» 
					<an:i>con la seguente</an:i>
					: «della» 
					<an:i>e sopprimere le parole</an:i>
					: «per ciascuna prova scritta».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
