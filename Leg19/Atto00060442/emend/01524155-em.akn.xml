		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>
						<an:b>Apportare le seguenti modificazioni:</an:b>
					</an:i>
				</an:p>
				<an:p>
					<an:b>
						<an:i>  a) al comma 4 sostituire le parole</an:i>
						: «da marzo a settembre» 
						<an:i>con le seguenti:</an:i>
						 «da marzo a dicembre»;
					</an:b>
					<an:i>al medesimo comma, sostituire le parole</an:i>
					: «16 milioni» con le seguenti: «50 milioni»;
				</an:p>
				<an:p>
					<an:i> b) al comma 5 sostituire le parole:</an:i>
					 «16 milioni» 
					<an:i>con le seguenti:</an:i>
					 «50 milioni»; 
					<an:i>al medesimo comma, aggiungere, in fine, le seguenti parole:</an:i>
					 «Agli oneri derivanti dalle lettere a) e b) pari a 50 milioni di euro per l'anno 2026, si provvede mediante corrispondente riduzione del Fondo per gli interventi strutturali di politica economica di cui all'articolo 10, comma 5, del decreto-legge 29 novembre 2004, n. 282, convertito, con modificazioni, dalla legge 27 dicembre 2004, n. 307».
				</an:p>
				<an:p>
					     C
					<an:i>onseguentemente,</an:i>
				</an:p>
				<an:p>
					<an:i>all'articolo 3, comma 2, sostituire le parole:</an:i>
					 «16 milioni di euro» 
					<an:i>con le seguenti:</an:i>
					 «50 milioni di euro».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
