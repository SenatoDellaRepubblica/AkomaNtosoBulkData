				<an:affectedDocument href="#ar1">Ddl 2029</an:affectedDocument>
			</an:p>
			<an:p>
				<an:docNumber>Emendamento n. COORD.1</an:docNumber>
			</an:p>
			<an:p>
				<an:docProponent refersTo="#ID0E5">
					<an:span style="font-variant:small-caps;">Il</an:span>
					 
					<an:span style="font-variant:small-caps;">Relatore</an:span>
				</an:docProponent>
			</an:p>
		</an:preface>
		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>All'articolo 1:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, le parole:</an:i>
					 «approvato con il» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «di cui al».
				</an:p>
				

				<an:p style="text-align:justify">
					   
					<an:i>All'articolo 2:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>                        al primo periodo, le parole:</an:i>
					 «di pozzi, al rilascio» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «di pozzi nonché al rilascio» 
					<an:i>e le parole:</an:i>
					 «ricezione dalla» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «ricezione della»;
				</an:p>
				

				<an:p style="text-align:justify">
					                                  
					<an:i>al quarto periodo, le parole:</an:i>
					 «del comma» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «del presente comma»;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 2, terzo periodo, le parole:</an:i>
					 «profili tecnici, socioeconomici» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «profili tecnici e socioeconomici».
				</an:p>
				

				<an:p style="text-align:justify">
					<an:i>All'articolo 3:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          
					<an:i>            al comma 1, le parole:</an:i>
					 «Fondo per gli interventi strutturali di politica economica» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «Fondo per interventi strutturali di politica economica,»;
				</an:p>
				

				<an:p style="text-align:justify">
					                      
					<an:i>al comma 2, dopo le parole:</an:i>
					 «dal comma 1» 
					<an:i>sono inserite le seguenti:</an:i>
					 «del presente articolo»
					<an:i>, le parole:</an:i>
					 «e dai commi 1 e 2 del medesimo articolo» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «, e dai commi 1 e 2 del medesimo articolo 1» 
					<an:i>e le parole:</an:i>
					 «Fondo per gli interventi strutturali di politica economica» 
					<an:i>sono sostituite dalle seguenti:</an:i>
					 «Fondo per interventi strutturali di politica economica,».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
