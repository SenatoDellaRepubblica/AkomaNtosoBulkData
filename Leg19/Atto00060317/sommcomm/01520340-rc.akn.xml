			<an:debateSection id="sede-d1e184" name="SCONVOCAZIONE DI SEDUTE">
				
            
				<an:heading id="h-d1e184">SCONVOCAZIONE DI SEDUTE</an:heading>
				
            
				<an:debateSection id="d-d1e187" name="">
					
               
					<an:heading id="h-d1e187"/>
					
               
					<an:speech by="#p36393" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p36393"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e193" href="#p36393">PRESIDENTE</an:ref>
							  comunica che le sedute già convocate per le ore 15 e per le ore 20 di oggi, venerdì 4 settembre, e per le ore 9,30 di domani, sabato 5 settembre, non avranno luogo.
						</an:p>
						
                  
						<an:p>            Prende atto la Commissione.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,30.</an:i>
							
                  
						</an:p>
						
                  
						<an:p>
							
                     
							<an:i> </an:i>
							
                  
