				<an:p>
					<an:i>All'emendamento 1.6, al</an:i>
					 Conseguentemente
					<an:i>, al capoverso</an:i>
					 "al comma 26, lettera c)"
					<an:i>, capoverso:</an:i>
					 "al capoverso «art. 93
					<an:i>-quinquies</an:i>
					»
					<an:i>, dopo il comma 3, inserire il seguente</an:i>
					", al capoverso "
					<an:i>3</an:i>
					-bis" sostituire le parole: "
					<an:i>60 per cento</an:i>
					" con le parole: "
					<an:i>50 per cento</an:i>
					".
				</an:p>
