		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>
						<an:b>All'emendamento 1.6, al</an:b>
					</an:i>
					<an:b>
						Conseguentemente
						<an:i>, capoverso</an:i>
					</an:b>
					<an:b>
						"sostituire il comma 24"
						<an:i>, capoverso</an:i>
					</an:b>
					<an:b>
						"24"
						<an:i>, al capoverso, comma 1, sopprimere il primo</an:i>
					</an:b>
					<an:i>e il terzo periodo.</an:i>
				</an:p>
				<an:p>
					<an:i>Conseguentemente</an:i>
					, al medesimo capoverso, comma 1, al secondo periodo, sostituire le parole: "Se eletto in più collegi plurinominali in posizione di capolista," con le parole: "Il deputato eletto in più collegi plurinominali".
				</an:p>
			</an:amendmentContent>
