				<an:p>
					<an:i>All'emendamento 1.6, al</an:i>
					 Conseguentemente
					<an:i>, capoverso:</an:i>
					 "all'articolo 2"
					<an:i>, capoverso</an:i>
					 "sostituire il comma 11 con il seguente"
					<an:i>, al capoverso</an:i>
					 "11"
					<an:i>, sostituire la lettera a) con la seguente:</an:i>
					 "a) al comma 1, le parole: «secondo l'ordine di presentazione» 
					<an:i>sono sostituite dalle parole:</an:i>
					 «in ragione del numero di preferenze ottenute da ciascun candidato, in ordine decrescente»
					<an:i>.</an:i>
				</an:p>
