		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>All'emendamento 1.6, al capoverso</an:i>
					 "Al comma 1, alla lettera a), premettere la seguente:"
					<an:i>, al capoverso</an:i>
					 "0a"
					<an:i>, sopprimere le parole</an:i>
					 ", ad eccezione del capolista,"
					<an:i>.</an:i>
				</an:p>
				<an:p>
					<an:i>Conseguentemente,</an:i>
					 al 
					<an:i>Conseguentemente,</an:i>
					 apportare le seguenti modificazioni:
				</an:p>
				<an:p>          a) al capoverso "sostituire il comma 4 con il seguente:", al capoverso "4", capoverso "2.", al secondo periodo, sopprimere le parole "tra quelli che non sono capolista";</an:p>
				<an:p>          b) al capoverso "al comma 15," capoverso "alla lettera a), al capoverso, sostituire il primo periodo con i seguenti:", al capoverso, al terzo periodo, sopprimere le parole "Ad eccezione del capolista,";</an:p>
				<an:p>          c) al capoverso "al comma 15," capoverso "alla lettera f), dopo il numero 2) aggiungere il seguente:", al numero 3), al capoverso, sopprimere le parole ", ad eccezione del capolista,";</an:p>
				<an:p>          d) al capoverso "al comma 16, sostituire la lettera a) con la seguente:", alla lettera a) al numero 1), sopprimere le parole ", escluso il capolista";</an:p>
				<an:p>          e) al capoverso "al comma 20", capoverso "sostituire la lettera d) con la seguente:", capoverso "d) la lettera d) è sostituita dalla seguente:", al capoverso "d)", al secondo periodo, sopprimere le parole ", escluso il capolista,";</an:p>
				<an:p>
					          f) al capoverso "al comma 26, lettera c)", al capoverso "capoverso «articolo 93
					<an:i>-sexies</an:i>
					»:", al capoverso, sopprimere le parole "Ad eccezione del capolista,";
				</an:p>
				<an:p>          g) al capoverso "all'articolo 2:", capoverso "sostituire il comma 2 con il seguente:", al capoverso "2", sopprimere le parole ", ad eccezione del capolista,";</an:p>
				<an:p>          h) al capoverso "all'articolo 2:", capoverso "al comma 7, sostituire la lettera a) con la seguente:", alla lettera a), al capoverso "1", al terzo periodo, sopprimere le parole "che non sono capolista,";</an:p>
				<an:p>          i) al capoverso "all'articolo 2:", capoverso "al comma 8:", al capoverso "sostituire la lettera d) dalla seguente:", alla lettera d), al secondo periodo, sopprimere le parole ", escluso il capolista,".</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
