		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>All'emendamento 1.6, al</an:i>
					 Conseguentemente
					<an:i>, capoverso</an:i>
					 "al capoverso «art. 93
					<an:i>-septies</an:i>
					»", capoverso: "
					<an:i>al comma 1, dopo la lettera d), aggiungere le seguenti:</an:i>
					", al capoverso "
					<an:i>d</an:i>
					-bis", secondo periodo, sopprimere le parole: "
					<an:i>, escluso il capolista,</an:i>
					".
				</an:p>
				<an:p>
					<an:i>Conseguentemente</an:i>
					, al medesimo capoverso, al capoverso: "al comma 2, lettera c), sostituire le parole", sopprimere le parole: "a partire dal candidato capolista e successivamente".
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
