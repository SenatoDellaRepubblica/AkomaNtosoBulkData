				<an:p>
					<an:i>Al comma 21, lettera d</an:i>
					)
					<an:i>, numero 2), dopo le parole:</an:i>
					 "al numero 1)," 
					<an:i>aggiungere le seguenti:</an:i>
					 "le parole: «20 per cento» sono sostituite dalle seguenti: «15 per cento» e";
				</an:p>
				<an:p>
					<an:i>Conseguentemente, al medesimo comma, medesima lettera:</an:i>
				</an:p>
				<an:p>
					<an:i>al numero 3), dopo le parole:</an:i>
					 "al numero 2)," 
					<an:i>aggiungere le seguenti:</an:i>
					 "le parole: «20 per cento» sono sostituite dalle seguenti «15 per cento» e";
				</an:p>
				<an:p>
					<an:i>al numero 4), capoverso 2-</an:i>
					bis) 
					<an:i>sostituire le parole:</an:i>
					 "20 per cento" 
					<an:i>con le seguenti</an:i>
					: "15 per cento".
				</an:p>
