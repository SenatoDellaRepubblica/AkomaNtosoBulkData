		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>All'emendamento 1.6, apportare le seguenti modificazioni:</an:i>
				</an:p>
				<an:p>
					<an:i>a)</an:i>
					<an:i>alla parte principale, al comma 1, lettera 0a) e ovunque ricorra nel testo, sopprimere le parole: "</an:i>
					ad eccezione del capolista
					<an:i>";</an:i>
				</an:p>
				<an:p>
					<an:i>b)</an:i>
					<an:i>alla parte consequenziale, relativa al comma 16, lettera a), punto 1), e ovunque ricorra nel testo, sopprimere le parole: "</an:i>
					escluso il capolista
					<an:i>";</an:i>
				</an:p>
				<an:p>
					<an:i>c)</an:i>
					<an:i>alla parte consequenziale, relativa al comma 23, lettera 0a), e ovunque ricorrano, sopprimere le parole: "</an:i>
					a partire dal candidato capolista e successivamente
					<an:i>";</an:i>
				</an:p>
				<an:p>
					<an:i>d)</an:i>
					<an:i>alla parte consequenziale, relativa al comma 24, sopprimere il comma 1;</an:i>
				</an:p>
				<an:p>
					<an:i>e)</an:i>
					<an:i>alla parte consequenziale, relativa all'articolo 2, comma 7, lettera a), sopprimere le parole: "</an:i>
					che non sono capolista
					<an:i>".</an:i>
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
