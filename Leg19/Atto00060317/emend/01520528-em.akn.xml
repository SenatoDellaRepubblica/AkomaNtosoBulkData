				<an:p>
					<an:i>All'emendamento 1.6, al</an:i>
					 Conseguentemente
					<an:i>, capoverso</an:i>
					 "all'articolo 2"
					<an:i>, al capoverso</an:i>
					 "alla lettera d), dopo il numero 1) aggiungere il seguente"
					<an:i>, sostituire il capoverso</an:i>
					 "1
					<an:i>-bis</an:i>
					" 
					<an:i>con il seguente: 1</an:i>
					-bis
					<an:i>) al secondo periodo, sostituire le parole:</an:i>
					 "60 per cento" 
					<an:i>con le parole:</an:i>
					 "50 per cento"
					<an:i>.</an:i>
					".
				</an:p>
