		<an:debateBody title="Resoconto n.436 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="00:00:00"/>
					La seduta inizia alle ore 9.
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="PROCEDURE INFORMATIVE">
				
            
				<an:heading id="h-d1e20">PROCEDURE INFORMATIVE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Seguito IC previdenza e assistenza sanitaria integrative: audizione rappresentanti Centro studi e ricerche Itinerari previdenziali">
					
               
					<an:heading id="h-d1e23">Seguito dell'indagine conoscitiva sulle forme integrative di previdenza e di assistenza sanitaria nel quadro dell'efficacia complessiva dei sistemi di welfare e di tutela della salute: comunicazioni del Presidente</an:heading>
					
               
					<an:narrative title="Fisionomia">Prosegue l'indagine conoscitiva, sospesa nella prima seduta antimeridiana del 25 giugno.</an:narrative>
					
               
					<an:speech by="#p32732" as="#senatore">
						
                  
						<an:from refersTo="#p32732"/>
						
                  
						<an:p>
							Il presidente 
							<an:ref id="d1e31" href="#p32732">ZAFFINI</an:ref>
							 comunica che il Ministro della salute ha trasmesso le risposte scritte ai quesiti formulati nel corso della predetta seduta, già messe a disposizione dei senatori.
						</an:p>
						
                  
						<an:p>Sarà altresì messa a disposizione una sintesi delle audizioni svolte e dei contributi acquisiti, curata dal consulente tecnico a suo tempo nominato a supporto dell'indagine conoscitiva.</an:p>
						
                  
						<an:p>Avverte quindi che, se non ci sono obiezioni, si considera così conclusa l'attività istruttoria dell'indagine conoscitiva. Propone, altresì, di soprassedere all'esame di un documento conclusivo.</an:p>
						
                  
						<an:p>Non essendovi obiezioni, così rimane stabilito.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e37" name="SULLA DISCUSSIONE DEL DISEGNO DI LEGGE N. 1101">
				
            
				<an:heading id="h-d1e37">SULLA DISCUSSIONE DEL DISEGNO DI LEGGE N. 1101</an:heading>
				
            
				<an:debateSection id="d-d1e40" name="">
					
               
					<an:heading id="h-d1e40"/>
					
               
					<an:speech by="#p32732" as="#senatore">
						
                  
						<an:from refersTo="#p32732"/>
						
                  
						<an:p>
							            In relazione alla trattazione del nuovo testo del disegno di legge n. 1101 (in materia di sicurezza sul lavoro e tutela delle vittime dell'amianto), il presidente 
							<an:ref id="d1e46" href="#p32732">ZAFFINI</an:ref>
							 comunica che l'emendamento 4.1 è stato ritirato.
						</an:p>
						
                  
						<an:p>            La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,10.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
