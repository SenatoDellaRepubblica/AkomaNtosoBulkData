				<an:debateSection id="d-d1e23" name="A.S. 2028 Disposizioni per il rafforzamento e l'adeguamento della capacit&amp;agrave; di difesa nazionale">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2028</an:docNumber>
						
                  
						<an:docTitle>Disposizioni per il rafforzamento e l'adeguamento della capacità di difesa nazionale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue la discussione, sospesa nella seduta del 29 settembre.</an:narrative>
					
               
					<an:speech by="#p1103" as="#senatore">
						
                  
						<an:from refersTo="#p1103"/>
						
                  
						<an:p>
							Il presidente 
							<an:ref id="d1e41" href="#p1103">GASPARRI</an:ref>
							 dà conto brevemente della programmazione delle sedute riguardanti il disegno di legge in argomento, ricordando che la relativa discussione generale avrà modo di proseguire anche nelle sedute di mercoledì 14 ottobre, alle ore 15, e di giovedì 15 ottobre, alle ore 9.
						</an:p>
						
                  
						<an:p>Apprezzate le circostanze, in particolare l'imminente ripresa dei lavori dell'Aula, rinvia, quindi, il seguito della discussione.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 15,35.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
