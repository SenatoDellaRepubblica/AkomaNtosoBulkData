		<an:debateBody title="Resoconto n.209 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="00:00:00"/>
					La seduta inizia alle ore 9.
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REDIGENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REDIGENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="A.S. 2028 Disposizioni per il rafforzamento e l'adeguamento della capacit&amp;agrave; di difesa nazionale">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>2028</an:docNumber>
						
                  
						<an:docTitle>Disposizioni per il rafforzamento e l'adeguamento della capacità di difesa nazionale</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito della discussione e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue la discussione, sospesa nella seduta del 27 ottobre.</an:narrative>
					
               
					<an:speech by="#p1103" as="#senatore">
						
                  
						<an:from refersTo="#p1103"/>
						
                  
						<an:p>
							Il presidente 
							<an:ref id="d1e41" href="#p1103">GASPARRI</an:ref>
							 informa che, alla scadenza del termine, risultano presentati 12 subemendamenti agli emendamenti del relatore, da considerarsi ammissibili, pubblicati in allegato.
						</an:p>
						
                  
						<an:p>Informa, quindi, che si può procedere all'illustrazione delle proposte emendative.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p32578" as="#senatore">
						
                  
						<an:from refersTo="#p32578"/>
						
                  
						<an:p>
							            Interviene, in proposito, il senatore 
							<an:ref id="d1e48" href="#p32578">ALFIERI</an:ref>
							 (
							<an:i>PD-IDP</an:i>
							), il quale rileva, in forma sintetica, che gli emendamenti presentati dal proprio Gruppo afferiscono, essenzialmente, ai temi disciplinati dagli articoli 6, sicurezza sui luoghi di lavoro, e 8, equilibrio tra il rispetto della normativa 
							<an:i>standard</an:i>
							 in materia ambientale e le esigenze specifiche della Difesa, del provvedimento.
						</an:p>
						
                  
						<an:p>            Dà atto, infine, al Presidente, di aver predisposto un percorso condiviso di approfondimento del disegno di legge in disamina, anche attraverso il pieno coinvolgimento, mediante audizioni, dei vertici militari e dei sindacati di settore.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p1103" as="#d1e59a1081">
						
                  
						<an:from refersTo="#p1103"/>
						
                  
						<an:p>
							            Nessun altro senatore chiedendo di intervenire in sede di illustrazione, il 
							<an:ref id="d1e59" href="#p1103">PRESIDENTE</an:ref>
							  propone di dare per illustrato l'insieme degli emendamenti, dei subemendamenti e degli ordini del giorno.
						</an:p>
						
                  
						<an:p>            La Commissione conviene.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p29293" as="#senatore">
						
                  
						<an:from refersTo="#p29293"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e66" href="#p29293">BORGHI</an:ref>
							 (
							<an:i>IV-CR</an:i>
							) segnala, sull'ordine dei lavori, l'opportunità, in vista della prossima fase di votazione degli emendamenti, di individuare degli orari di convocazione delle sedute della Commissione che siano compatibili con quelli di altri organismi, come, ad esempio, il Copasir, di cui fanno parte due membri della Commissione stessa.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p1103" as="#senatore">
						
                  
						<an:from refersTo="#p1103"/>
						
                  
						<an:p>
							            Il presidente 
							<an:ref id="d1e74" href="#p1103">GASPARRI</an:ref>
							 raccoglie con favore tale sollecitazione, assicurando che si cercherà di predisporre un calendario che eviti una possibile sovrapposizione di impegni.
						</an:p>
						
                  
						<an:p>Il seguito della discussione è, quindi, rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,20.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
