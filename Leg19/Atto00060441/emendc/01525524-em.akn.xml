		<an:preface>
			<an:p>
				<an:affectedDocument href="#ar1">Ddl 2028</an:affectedDocument>
			</an:p>
			<an:p>
				<an:docNumber>Emendamento n. 4.3</an:docNumber>
			</an:p>
			<an:p>
				<an:docProponent refersTo="#ID0E5">
					<an:span style="font-variant:small-caps;">Il</an:span>
					 
					<an:span style="font-variant:small-caps;">Relatore</an:span>
				</an:docProponent>
			</an:p>
		</an:preface>
		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>All'articolo 4, comma 1, dopo la lettera</an:i>
					 a) 
					<an:i>inserire la seguente:</an:i>
				</an:p>
				

				<an:p style="margin-left:0cm; text-align:justify">
					          «
					<an:i>a</an:i>
					-bis) all'articolo 801 sono apportate le seguenti modificazioni:
				</an:p>
				

				<an:p style="margin-left:14.2pt; margin-right:0cm; text-align:justify">          1) al comma 4:</an:p>
				

				<an:p style="margin-left:1cm; margin-right:0cm; text-align:justify">
					          1.1) dopo la lettera 
					<an:i>a</an:i>
					) sono inserite le seguenti:
				</an:p>
				

				<an:p style="margin-left:1cm; text-align:justify">
					          
					<an:i>a</an:i>
					-bis
					<an:i>)</an:i>
					 gli ufficiali generali o ammiragli nominati Capi di Stato Maggiore di Forza armata;
				</an:p>
				

				<an:p style="margin-left:0cm; text-align:justify">
					          
					<an:i>a</an:i>
					-ter
					<an:i>)</an:i>
					 gli ufficiali generali o ammiragli impiegati come direttori delle direzioni della Direzione nazionale degli armamenti;
				</an:p>
				

				<an:p style="margin-left:1cm; margin-right:0cm; text-align:justify">
					          1.2) alla lettera 
					<an:i>b</an:i>
					-bis):
				</an:p>
				

				<an:p style="margin-left:1cm; text-align:justify">
					          1.2.1) dopo le parole «gli ufficiali generali» sono inserite le seguenti: 
					<an:i>«, colonnelli</an:i>
					»;
				</an:p>
				

				<an:p style="margin-left:1cm; text-align:justify">
					          1.2.2) e le parole «lettere 
					<an:i>b)</an:i>
					 e 
					<an:i>c),</an:i>
					» sono soppresse;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          1.3) alla lettera 
					<an:i>d</an:i>
					), dopo le parole «a ordinamento militare» sono inserite le seguenti: «e gli ufficiali dell'Arma dei carabinieri impiegati in incarichi interforze di polizia»;
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          1.4) dopo la lettera 
					<an:i>f)</an:i>
					 è inserita la seguente: «
					<an:i>f</an:i>
					-bis) gli ufficiali dell'Esercito italiano, della Marina militare e dell'Aeronautica militare impiegati presso enti, comandi od organismi internazionali in Italia, e, ai sensi dell'articolo 1808, presso delegazioni, rappresentanze militari nazionali e comandi od organismi internazionali costituiti all'estero ovvero per conto delle agenzie di cooperazione internazionale.»;
				</an:p>
				

				<an:p style="margin-left:14.2pt; margin-right:0cm; text-align:justify">
					          2) al comma 6, le parole «
					<an:i>d)</an:i>
					 ed 
					<an:i>f)</an:i>
					» sono sostituite dalle seguenti «
					<an:i>d), f)</an:i>
					 e 
					<an:i>f</an:i>
					-bis
					<an:i>)</an:i>
					».».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
