		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					          
					<an:i>
						<an:span style="font-size:medium">Al comma 1, capoverso 2</an:span>
					</an:i>
					<an:span style="font-size:medium">
						<an:i>-bis</an:i>
						<an:i>.:</an:i>
					</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">
						<an:i>- dopo le parole "</an:i>
						informato e addestrato per le attività specifiche da svolgere" sono inserite le seguenti "e sui rischi specifici";
					</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">- dopo le parole "le attrezzature, i materiali e gli equipaggiamenti" sono aggiunte le seguenti ", ivi compresi i dispositivi di protezione individuale,";</an:span>
				</an:p>
				

				<an:p style="margin-left:0cm; margin-right:0cm; text-align:justify">
					          
					<an:span style="font-size:medium">- dopo le parole "a tutela della salute e della sicurezza indicate dal regolamento", sono aggiunte le seguenti "; sono assicurate la registrazione degli infortuni e degli incidenti e la conservazione della documentazione necessaria ai fini della tutela sanitaria, previdenziale e assistenziale e dell'eventuale riconoscimento della dipendenza da causa di servizio".</an:span>
				</an:p>
			</an:amendmentContent>
