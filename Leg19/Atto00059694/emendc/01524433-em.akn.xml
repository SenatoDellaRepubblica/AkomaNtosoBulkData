			<an:amendmentContent>
				<an:p>
					<an:i>All'emendamento 1.102, numero 1), apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          a) 
					<an:i>sostituire le parole</an:i>
					 « esprimono pareri non vincolanti nelle» 
					<an:i>con le seguenti</an:i>
					: « partecipano alle»;
				</an:p>
				

				<an:p style="text-align:justify">
					          b) 
					<an:i>sostituire le parole</an:i>
					 « degli educatori dei servizi educativi per l'infanzia» 
					<an:i>con le seguenti</an:i>
					: «degli iscritti nell'elenco speciale riservato agli educatori dei servizi educativi per l'infanzia in possesso di titoli di cui all'articolo 4, comma 2, lettera b)».
				</an:p>
			</an:amendmentContent>
