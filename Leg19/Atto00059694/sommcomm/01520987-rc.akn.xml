		<an:debateBody title="Resoconto n.432 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="09:40:00"/>
					La seduta inizia alle ore 9,40
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="SUI LAVORI DELLA COMMISSIONE">
				
            
				<an:heading id="h-d1e20">SUI LAVORI DELLA COMMISSIONE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:speech by="#p22877" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e29" href="#p22877">PRESIDENTE</an:ref>
							  informa la Commissione che l'Ufficio di Presidenza integrato dai rappresentanti dei Gruppi, riunitosi al termine della seduta pomeridiana di ieri, ha stabilito di procedere allo svolgimento di un ciclo di audizioni sui disegni di legge in materia di legittima difesa. Il termine per indicare eventuali soggetti da audire è fissato per le ore 12 di lunedì 21 settembre.
						</an:p>
						
                  
						<an:p>            La Commissione prende atto.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e33" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e33">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e36" name="Professioni pedagogiche ed educative">
					
               
					<an:heading id="h-d1e36"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1712</an:docNumber>
						
                  
						<an:docTitle>Modifiche alla legge 15 aprile 2024, n. 55, in materia di disciplina delle professioni pedagogiche ed educative</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">Prosegue l'esame sospeso nella seduta del 22 luglio scorso.</an:narrative>
					
               
					<an:speech by="#p22877" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e54" href="#p22877">PRESIDENTE</an:ref>
							  ricorda che nelle sedute di luglio si è conclusa l'illustrazione degli emendamenti e che sono stati presentati tre emendamenti da parte del Governo. Inoltre, fa presente che il Gruppo del Movimento 5 Stelle aveva ritirato tutte le proposte di modifica presentate. Avverte quindi che, già la prossima settimana, potrà iniziare l'esame degli emendamenti dal momento che la relativa istruttoria è in corso. Chiede quindi se vi siano interventi.
						</an:p>
						
                  
						<an:p>Non essendovi richieste di intervento, rinvia il seguito dell'esame.</an:p>
						
                  
						<an:p>            Il seguito dell'esame è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:debateSection id="d-d1e59" name="Disposizioni in materia di allontanamento del minore">
					
               
					<an:heading id="h-d1e59"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1831</an:docNumber>
						
                  
						<an:docTitle>Disposizioni in materia di allontanamento del minore</an:docTitle>
						
                  
						<an:docProponent>MALAN e altri.</an:docProponent>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">            Prosegue l'esame sospeso nella seduta del 22 luglio scorso.</an:narrative>
					
               
					<an:speech by="#p22877" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e79" href="#p22877">PRESIDENTE</an:ref>
							  avverte che non è ancora pervenuto il prescritto parere della Commissione bilancio sul testo del disegno di legge. Chiede quindi se vi siano interventi.
						</an:p>
						
                  
						<an:p>Non essendovi richieste di intervento, rinvia il seguito dell'esame.</an:p>
						
                  
						<an:p>            Il seguito dell'esame è quindi rinviato.</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03" xmlns:si="http://www.senato.it/static/xml/def/1.0/sindisp.html"/>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e84" name="SCONVOCAZIONE DELLA SEDUTA DI DOMANI">
				
            
				<an:heading id="h-d1e84">SCONVOCAZIONE DELLA SEDUTA DI DOMANI</an:heading>
				
            
				<an:debateSection id="d-d1e87" name="">
					
               
					<an:heading id="h-d1e87"/>
					
               
					<an:speech by="#p22877" as="#d1e29a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e93" href="#p22877">PRESIDENTE</an:ref>
							  comunica che la seduta già convocata per domani giovedì 17 settembre, alle ore 9,30, non avrà luogo.
						</an:p>
						
                  
						<an:p>La Commissione prende atto.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,55.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
