		<an:amendmentBody>
			<an:amendmentContent>
				<an:p>
					<an:i>Al comma 1, primo periodo, sostituire le parole</an:i>
					: «100 milioni di euro, di cui 30 milioni di euro per l'anno 2026 e 70 milioni di euro per l'anno 2027» 
					<an:i>con le seguenti</an:i>
					: «200 milioni di euro, di cui 60 milioni di euro per l'anno 2026 e 140 milioni di euro per l'anno 2027». 
					<an:i>Conseguentemente, al comma 5, sostituire le parole</an:i>
					: «100 milioni di euro, di cui euro 30 milioni per l'anno 2026 ed euro 70 milioni per l'anno 2027» 
					<an:i>con le seguenti</an:i>
					: «200 milioni di euro, di cui euro 60 milioni per l'anno 2026 ed euro 140 milioni per l'anno 2027».
				</an:p>
			</an:amendmentContent>
