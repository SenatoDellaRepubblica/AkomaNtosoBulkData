		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="line-height:normal;background:white;">
					<an:i>Al comma 1, primo periodo, sostituire le parole</an:i>
					: la data di entrata in vigore del presente decreto 
					<an:i>con le seguenti:</an:i>
					 il 31 ottobre 2026.
				</an:p>
				

				<an:p style="line-height:normal;background:white;">
					     
					<an:i>Conseguentemente:</an:i>
				</an:p>
				

				<an:p style="line-height:normal;background:white;">
					          
					<an:i>al medesimo comma 1, secondo periodo, sostituire le parole</an:i>
					: alla data di entrata in vigore del presente decreto 
					<an:i>con le seguenti:</an:i>
					 entro il 31 ottobre 2026;
				</an:p>
				

				<an:p style="line-height:normal;background:white;">
					          
					<an:i>al comma 2, dopo il primo periodo, aggiungere il seguente</an:i>
					: I contributi di cui al comma 1 continuano ad essere corrisposti fino all'effettivo ripristino delle condizioni di sicurezza dell'abitazione e alla concreta possibilità di rientro nella stessa, anche qualora sia stato concesso o erogato il contributo per la riparazione dell'edificio;
				</an:p>
				

				<an:p style="line-height:normal;background:white;">
					          
					<an:i>al comma 4, primo periodo, sostituire la parola:</an:i>
					 1.875.000 
					<an:i>con la seguente:</an:i>
					 3.500.000 
					<an:i>e la parola:</an:i>
					 4.500.000 
					<an:i>con la seguente:</an:i>
					 7.000.000.
					<an:eol/>
					

					<an:eol/>
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
