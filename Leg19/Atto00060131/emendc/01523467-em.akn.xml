		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="text-align:justify">
					<an:i>Al comma 1, lettera i), capoverso «Art. 657</an:i>
					-bis
					<an:i>»,</an:i>
					 
					<an:i>apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="text-align:justify">
					          a) 
					<an:i>al primo comma, terzo periodo, sostituire le parole:</an:i>
					 «nella misura dell'1 per cento» 
					<an:i>con le seguenti:</an:i>
					 «in misura non superiore all'1 per cento» 
					<an:i>e aggiungere, in fine, le parole:</an:i>
					 «, salvo che ciò sia manifestamente iniquo»;
				</an:p>
				

				<an:p style="text-align:justify">
					          b) 
					<an:i>al sesto comma aggiungere, in fine, le seguenti parole:</an:i>
					 «, anche senza previa instaurazione del contraddittorio, salva la successiva fissazione dell'udienza di comparizione delle parti entro il termine stabilito.».
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
