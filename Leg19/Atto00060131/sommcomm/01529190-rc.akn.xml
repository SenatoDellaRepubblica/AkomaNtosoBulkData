		<an:debateBody title="Resoconto n.464 della legislatura 19">
			
         
			<an:debateSection id="d1e18" name="InizioSeduta">
				
            
				<an:narrative title="InizioSeduta">
					
               
					<an:recordedTime time="09:15:00"/>
					La seduta inizia alle ore 9,15
				</an:narrative>
				
         
			</an:debateSection>
			
         
			<an:debateSection id="sede-d1e20" name="IN SEDE REFERENTE">
				
            
				<an:heading id="h-d1e20">IN SEDE REFERENTE</an:heading>
				
            
				<an:debateSection id="d-d1e23" name="Disposizioni in materia di rilascio di immobili">
					
               
					<an:heading id="h-d1e23"/>
					
               
					<an:block name="Atto">
						
                  
						<an:docType>DDL</an:docType>
						
                  
						<an:docNumber>1896</an:docNumber>
						
                  
						<an:docTitle>Disposizioni in materia di rilascio di immobili</an:docTitle>
						
                  
						<an:docProponent/>
						
                  
						<an:docStatus>
							
                     
							<an:eol/>
							Seguito dell'esame e rinvio
						</an:docStatus>
						
               
					</an:block>
					
               
					<an:narrative title="Fisionomia">
						            Prosegue l'esame sospeso nella seduta antimeridiana di ieri
						<an:i>.</an:i>
						
               
					</an:narrative>
					
               
					<an:speech by="#p22877" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e43" href="#p22877">PRESIDENTE</an:ref>
							  chiede al relatore e al rappresentante del Governo di esprimere i pareri sugli emendamenti riferiti agli articoli 9, 10 e 11, al fine di poter avere un quadro complessivo degli orientamenti sulle proposte emendative presentate.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p17811" as="#senatore">
						
                  
						<an:from refersTo="#p17811"/>
						
                  
						<an:p>
							            Il relatore 
							<an:ref id="d1e49" href="#p17811">ZANETTIN</an:ref>
							 (
							<an:i>FI-BP-PPE</an:i>
							) esprime parere contrario sugli emendamenti 9.1, 9.2, 9.3, 10.1, 10.2, 11.1 e 11.2.
						</an:p>
						
                  
						<an:p>            Il vice ministro SISTO esprime parere conforme a quello del relatore.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p22877" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e58" href="#p22877">PRESIDENTE</an:ref>
							  chiede poi se vi siano aggiornamenti rispetto al parere sugli emendamenti accantonati nelle precedenti sedute.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p17811" as="#senatore">
						
                  
						<an:from refersTo="#p17811"/>
						
                  
						<an:p>
							            Il relatore 
							<an:ref id="d1e64" href="#p17811">ZANETTIN</an:ref>
							 (
							<an:i>FI-BP-PPE</an:i>
							) conferma la richiesta di accantonamento sugli emendamenti 1.50, 1.51, 1.52, 1.54, 1.105, 3.0.3 e 5.0.1. Sugli emendamenti 3.4, 3.5, 3.0.1 e 3.0.2 ribadisce invece che il parere favorevole è subordinato all'accoglimento della riformulazione illustrata nella seduta di ieri.
						</an:p>
						
                  
						<an:p>            Il vice ministro SISTO esprime parere conforme a quello del relatore.</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36442" as="#senatore">
						
                  
						<an:from refersTo="#p36442"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e73" href="#p36442">RASTRELLI</an:ref>
							 (
							<an:i>FdI</an:i>
							) aggiunge la firma all'emendamento 3.4 e accoglie la riformulazione proposta dal relatore in un testo 2, pubblicato in allegato al resoconto della seduta odierna.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p33022" as="#senatore">
						
                  
						<an:from refersTo="#p33022"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e81" href="#p33022">POTENTI</an:ref>
							 (
							<an:i>LSP-PSd'Az</an:i>
							) rileva come su una tematica così importante sia indispensabile un accordo unanime dei Gruppi di maggioranza. Pertanto accoglie la riformulazione proposta dal relatore dell'emendamento 3.5 in un testo 2, pubblicato in allegato al resoconto della seduta odierna.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36404" as="#senatore">
						
                  
						<an:from refersTo="#p36404"/>
						
                  
						<an:p>
							            La senatrice 
							<an:ref id="d1e89" href="#p36404">LOPREIATO</an:ref>
							 (
							<an:i>M5S</an:i>
							) dichiara invece di non accogliere la riformulazione proposta dal relatore per l'emendamento 3.0.2.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p22877" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							            Il 
							<an:ref id="d1e97" href="#p22877">PRESIDENTE</an:ref>
							  ricorda quindi che nella seduta di ieri erano stati esaminati gli emendamenti da 6.2 a 6.5 (testo 2), e che sulle proposte presentate agli articoli 6, 7 e 8 il relatore e il rappresentante del Governo avevano già espresso tutti i pareri. Chiede quindi al relatore e al rappresentante del Governo se sia confermata la richiesta di accantonamento per le proposte 6.0.2, 6.0.3 e 6.0.4.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p17811" as="#senatore">
						
                  
						<an:from refersTo="#p17811"/>
						
                  
						<an:p>
							            Il relatore 
							<an:ref id="d1e103" href="#p17811">ZANETTIN</an:ref>
							 (
							<an:i>FI-BP-PPE</an:i>
							), anche in considerazione della necessità di approfondire, conferma tale richiesta; il vice ministro SISTO si esprime in senso conforme.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p22877" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							            In relazione poi agli emendamenti riferiti all'articolo 8, il 
							<an:ref id="d1e112" href="#p22877">PRESIDENTE</an:ref>
							  ricorda che il relatore ed il rappresentante del Governo avevano espresso su alcune proposte un parere di invito al ritiro. Chiede quindi ai presentatori se intendano ritirare gli emendamenti 8.0.2, 8.0.3, 8.0.4, 8.0.5, 8.0.6, 8.0.7, 8.0.8, 8.0.9 e 8.0.10.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p36419" as="#senatore">
						
                  
						<an:from refersTo="#p36419"/>
						
                  
						<an:p>
							            Il senatore 
							<an:ref id="d1e118" href="#p36419">RAPANI</an:ref>
							 (
							<an:i>FdI</an:i>
							) si riserva di ritirare le proposte a seguito di ulteriori approfondimenti.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p17811" as="#senatore">
						
                  
						<an:from refersTo="#p17811"/>
						
                  
						<an:p>
							            Il relatore 
							<an:ref id="d1e126" href="#p17811">ZANETTIN</an:ref>
							 (
							<an:i>FI-BP-PPE</an:i>
							) precisa che il parere di invito al ritiro è giustificato dalla circostanza che le proposte citate comportano oneri finanziari e pertanto potrebbero essere problematici.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p25429" as="#senatore">
						
                  
						<an:from refersTo="#p25429"/>
						
                  
						<an:p>
							            La senatrice 
							<an:ref id="d1e134" href="#p25429">PETRENGA</an:ref>
							 (
							<an:i>Cd'I-UDC-NM (NcI, CI, IaC)-MAIE-CP</an:i>
							) sottoscrive gli emendamenti 8.0.3, 8.0.5, 8.0.7, 8.0.9 e 8.0.10, riservandosi a sua volta di valutare l'opportunità di un ritiro.
						</an:p>
						
               
					</an:speech>
					
               
					<an:speech by="#p22877" as="#d1e43a1081">
						
                  
						<an:from refersTo="#p22877"/>
						
                  
						<an:p>
							Il 
							<an:ref id="d1e142" href="#p22877">PRESIDENTE</an:ref>
							 , anche in considerazione dell'imminente inizio dei lavori dell'Assemblea, rinvia il seguito dell'esame.
						</an:p>
						
                  
						<an:p>            Il seguito dell'esame è quindi rinviato.</an:p>
						
                  
						<an:p>
							
                     
							<an:i>La seduta termina alle ore 9,30.</an:i>
							
                  
						</an:p>
						
               
					</an:speech>
					
            
				</an:debateSection>
				
            
