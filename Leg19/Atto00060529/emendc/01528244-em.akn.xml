		<an:amendmentBody>
			<an:amendmentContent>
				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					<an:i>Apportare le seguenti modificazioni:</an:i>
				</an:p>
				

				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					          
					<an:i>a) al comma 1, sostituire le parole: «</an:i>
					25.000 euro» 
					<an:i>con le seguenti: «</an:i>
					30.000 euro» 
					<an:i>e sopprimere le parole</an:i>
					: «che non svolga attività lavorativa ovvero la svolga percependo da essa un reddito non superiore a 3.000 euro lordi annui.»;
				</an:p>
				

				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					          
					<an:i>b) al  comma 3:</an:i>
				</an:p>
				

				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					          
					<an:i>1) al primo periodo, sostituire le parole:</an:i>
					 «nel limite pro capite massimo trimestrale di 1.200 euro» 
					<an:i>con le seguenti:</an:i>
					 «nel limite pro capite massimo di 1.500 euro.»;
				</an:p>
				

				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					          
					<an:i>2) al secondo periodo, sostituire, ovunque ricorrano, le parole:</an:i>
					 «25.000» 
					<an:i>con le seguenti:</an:i>
					 «30.000».
				</an:p>
				

				<an:p style="margin-top:2.0pt;margin-right:0cm;margin-bottom:2.0pt;margin-left:0cm;text-align:justify;">
					     
					<an:i>Conseguentemente, il Fondo per gli interventi strutturali di politica economica di cui all'articolo 10, comma 5, del decreto-legge 29 novembre 2004, n. 282, convertito, con modificazioni, dalla legge 27 dicembre 2004, n. 307, è ridotto di 300 milioni di euro per ciascuno degli anni dal 2027 al 2034.</an:i>
				</an:p>
			</an:amendmentContent>
		</an:amendmentBody>
	</an:amendment>
