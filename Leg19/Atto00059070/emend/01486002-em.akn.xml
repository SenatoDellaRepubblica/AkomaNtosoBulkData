				<an:p xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0/CSD03">
					<an:outcome id="esito">Respinta la parte evidenziata in neretto; preclusa la restante parte</an:outcome>
				</an:p>
			</an:amendmentContent>
